{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://promptly.dev/schemas/template.json",
  "title": "Promptly Template",
  "description": "Schema for Promptly template definitions",
  "type": "object",
  "required": ["name", "content"],
  "properties": {
    "name": {
      "type": "string",
      "description": "Template name (lowercase, alphanumeric, hyphens, underscores)",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[a-z0-9_-]+$"
    },
    "content": {
      "type": "string",
      "description": "Template content (Jinja2 format)",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "description": "Human-readable description of the template"
    },
    "category": {
      "type": "string",
      "description": "Template category",
      "enum": [
        "base",
        "role",
        "domain",
        "pattern",
        "general"
      ]
    },
    "tags": {
      "type": "array",
      "description": "Tags for classification and discovery",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "defaults": {
      "type": "object",
      "description": "Default values for template variables",
      "additionalProperties": true
    },
    "parameters": {
      "type": "array",
      "description": "Template parameter definitions",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": ["string", "number", "boolean", "array", "object"]
          },
          "description": {
            "type": "string"
          },
          "required": {
            "type": "boolean",
            "default": false
          },
          "default": {
            "description": "Default value for this parameter"
          }
        }
      }
    },
    "examples": {
      "type": "array",
      "description": "Usage examples",
      "items": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "variables": {
            "type": "object"
          },
          "expected_output": {
            "type": "string"
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "description": "Additional metadata",
      "properties": {
        "author": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "license": {
          "type": "string"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": true
    },
    "base_template": {
      "type": "string",
      "description": "Name of base template to extend from"
    },
    "mixins": {
      "type": "array",
      "description": "Mixins to apply to this template",
      "items": {
        "type": "string"
      }
    }
  }
}
