# O2 Platform Configuration
# Copy this file to .env and fill in your values

# ============================================
# Matrix Configuration
# ============================================

# Your Matrix server name (e.g., matrix.example.com)
# For local testing, use matrix.localhost
MATRIX_SERVER_NAME=matrix.localhost

# O2 bot password (generate with: openssl rand -base64 32)
O2_BOT_PASSWORD=changeme_generate_secure_password

# ============================================
# Database Configuration
# ============================================

# PostgreSQL password for Synapse
POSTGRES_PASSWORD=changeme_postgres_password

# PostgreSQL password for O2 database
O2_DB_PASSWORD=changeme_o2_db_password

# Neo4j password (optional, for production)
NEO4J_PASSWORD=changeme_neo4j_password

# ============================================
# LLM Configuration
# ============================================

# Ollama (local LLM) - default URL for Docker Desktop
OLLAMA_BASE_URL=http://host.docker.internal:11434

# OpenAI API key (optional)
OPENAI_API_KEY=

# Anthropic API key (optional)
ANTHROPIC_API_KEY=

# ============================================
# HoloLoom Configuration
# ============================================

# HoloLoom execution mode: bare, fast, fused
HOLOLOOM_CONFIG=fast

# Memory backend: inmemory, hybrid, hyperspace
# inmemory: In-memory graphs (development, testing)
# hybrid: Neo4j + Qdrant with auto-fallback (production)
# hyperspace: Advanced gated multipass (research)
HOLOLOOM_MEMORY_BACKEND=inmemory

# ============================================
# O2 Features
# ============================================

# Enable democratic governance (voting, proposals)
O2_ENABLE_GOVERNANCE=true

# Enable agentic swarm (multi-agent collaboration)
O2_ENABLE_SWARM=true

# Enable alignment framework (safety guardrails)
O2_ENABLE_ALIGNMENT=true

# ============================================
# Logging & Debugging
# ============================================

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ============================================
# Production Settings (optional)
# ============================================

# Domain name for SSL certificates (production only)
# DOMAIN_NAME=o2.example.com

# Email for Let's Encrypt (production only)
# LETSENCRYPT_EMAIL=admin@example.com

# ============================================
# Security Notes
# ============================================

# 1. Generate strong passwords:
#    openssl rand -base64 32
#
# 2. Never commit .env to version control
#
# 3. For production:
#    - Use strong passwords (32+ characters)
#    - Enable HTTPS (uncomment nginx/certbot in docker-compose)
#    - Configure firewall (only expose 80, 443, 8448)
#    - Regular backups (postgres-data, user-memories)
#
# 4. For local testing:
#    - Default passwords OK for localhost
#    - No HTTPS needed
