            "max_iterations": {"type": "integer", "default": 3}
          },
          "required": ["prompt_name", "query", "response"]
        }
      },
      {
        "name": "promptly_mrf_recommend",
        "description": "Get Thompson Sampling MRF strategy recommendation",
        "inputSchema": {
          "type": "object",
          "properties": {
            "query_type": {"type": "string"}
          },
          "required": ["query_type"]
        }
      },
      {
        "name": "promptly_mrf_analytics",
        "description": "Get MRF learning statistics",
        "inputSchema": {
          "type": "object",
          "properties": {}
        }
      },
      {
        "name": "promptly_mrf_history",
        "description": "Get available MRF task templates",
        "inputSchema": {
          "type": "object",
          "properties": {}
        }
      }
    ]
  }
}
