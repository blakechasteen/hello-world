        "description": "Get Thompson Sampling recommendation for the best MRF refinement strategy.",
        "input_schema": {
          "type": "object",
          "properties": {
            "query_type": {"type": "string", "description": "Type of query"}
          },
          "required": ["query_type"]
        }
      }
    ]
  },
  "mcp_format": {
    "description": "Tools formatted for MCP (Model Context Protocol)",
    "tools": [
      {
        "name": "promptly_analytics_stats",
        "description": "Get comprehensive analytics for a prompt",
        "inputSchema": {
          "type": "object",
          "properties": {
            "prompt_name": {"type": "string"},
            "days": {"type": "integer", "default": 30}
          },
          "required": ["prompt_name"]
        }
      },
      {
        "name": "promptly_recommend",
        "description": "Get Thompson Sampling recommendation for best prompt",
        "inputSchema": {
          "type": "object",
          "properties": {
            "task_type": {"type": "string"},
            "candidates": {"type": "array", "items": {"type": "string"}}
          },
          "required": ["task_type"]
        }
      },
      {
        "name": "promptly_hololoom_enhance",
        "description": "Enhance prompt with RAG context from HoloLoom",
        "inputSchema": {
          "type": "object",
          "properties": {
            "prompt_name": {"type": "string"},
            "task_description": {"type": "string"},
            "context_k": {"type": "integer", "default": 5}
          },
          "required": ["prompt_name"]
        }
      },
      {
        "name": "promptly_hololoom_agentic",
        "description": "Execute with agentic reasoning",
        "inputSchema": {
          "type": "object",
          "properties": {
            "prompt_name": {"type": "string"},
            "mode": {"type": "string", "enum": ["direct", "verify", "research", "plan_execute"]},
            "variables": {"type": "object"},
            "max_steps": {"type": "integer", "default": 5}
          },
          "required": ["prompt_name", "mode"]
        }
      },
      {
        "name": "promptly_mrf_enhance",
        "description": "Enhance prompt with 7-component MRF metaprompt framework",
        "inputSchema": {
          "type": "object",
          "properties": {
            "prompt_name": {"type": "string"},
            "prompt_content": {"type": "string"},
            "task_type": {"type": "string"},
            "model_provider": {"type": "string", "enum": ["claude", "gemini", "gpt", "ollama"], "default": "claude"}
          },
          "required": ["prompt_name", "prompt_content"]
        }
      },
      {
        "name": "promptly_mrf_refine",
