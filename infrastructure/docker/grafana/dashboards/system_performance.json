{
  "dashboard": {
    "title": "HoloLoom System Performance",
    "uid": "hololoom-system-performance",
    "timezone": "browser",
    "schemaVersion": 27,
    "version": 1,
    "refresh": "30s",
    "tags": ["hololoom", "performance", "infrastructure"],
    "panels": [
      {
        "id": 1,
        "title": "Container Status",
        "type": "stat",
        "gridPos": {"h": 3, "w": 24, "x": 0, "y": 0},
        "targets": [
          {
            "expr": "up{job='hololoom-api'}",
            "refId": "A",
            "legendFormat": "HoloLoom API"
          },
          {
            "expr": "up{job='emotion-intelligence'}",
            "refId": "B",
            "legendFormat": "Emotion Intelligence"
          },
          {
            "expr": "up{job='neo4j'}",
            "refId": "C",
            "legendFormat": "Neo4j"
          },
          {
            "expr": "up{job='qdrant'}",
            "refId": "D",
            "legendFormat": "Qdrant"
          }
        ],
        "options": {
          "colorMode": "background",
          "graphMode": "none",
          "justifyMode": "auto",
          "orientation": "horizontal",
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"],
            "fields": ""
          }
        },
        "fieldConfig": {
          "defaults": {
            "mappings": [
              {
                "type": "value",
                "options": {
                  "0": {"text": "DOWN", "color": "red"},
                  "1": {"text": "UP", "color": "green"}
                }
              }
            ],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": null, "color": "red"},
                {"value": 1, "color": "green"}
              ]
            }
          }
        }
      },
      {
        "id": 2,
        "title": "HoloLoom API - Request Rate",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 3},
        "targets": [
          {
            "expr": "rate(hololoom_requests_total[5m])",
            "refId": "A",
            "legendFormat": "Requests/sec"
          }
        ],
        "yaxes": [
          {
            "format": "short",
            "label": "req/s",
            "logBase": 1,
            "show": true
          },
          {
            "format": "short",
            "logBase": 1,
            "show": false
          }
        ],
        "xaxis": {
          "mode": "time",
          "show": true
        },
        "lines": true,
        "fill": 1,
        "linewidth": 2,
        "points": false,
        "bars": false,
        "stack": false,
        "legend": {
          "show": true,
          "values": true,
          "min": false,
          "max": true,
          "current": true,
          "total": false,
          "avg": true
        }
      },
      {
        "id": 3,
        "title": "HoloLoom API - Latency",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 3},
        "targets": [
          {
            "expr": "hololoom_query_latency_ms{quantile='0.5'}",
            "refId": "A",
            "legendFormat": "p50"
          },
          {
            "expr": "hololoom_query_latency_ms{quantile='0.95'}",
            "refId": "B",
            "legendFormat": "p95"
          },
          {
            "expr": "hololoom_query_latency_ms{quantile='0.99'}",
            "refId": "C",
            "legendFormat": "p99"
          }
        ],
        "yaxes": [
          {
            "format": "ms",
            "label": "Latency",
            "logBase": 1,
            "show": true
          },
          {
            "format": "short",
            "logBase": 1,
            "show": false
          }
        ],
        "xaxis": {
          "mode": "time",
          "show": true
        },
        "lines": true,
        "fill": 1,
        "linewidth": 2,
        "points": false,
        "bars": false,
        "stack": false,
        "legend": {
          "show": true,
          "values": true,
          "min": false,
          "max": true,
          "current": true,
          "total": false,
          "avg": true
        },
        "alert": {
          "conditions": [
            {
              "evaluator": {
                "params": [500],
                "type": "gt"
              },
              "operator": {
                "type": "and"
              },
              "query": {
                "params": ["B", "5m", "now"]
              },
              "reducer": {
                "params": [],
                "type": "avg"
              },
              "type": "query"
            }
          ],
          "executionErrorState": "alerting",
          "for": "5m",
          "frequency": "1m",
          "message": "P95 latency exceeded 500ms",
          "name": "High Latency Alert",
          "noDataState": "no_data",
          "notifications": []
        }
      },
      {
        "id": 4,
        "title": "Memory Usage by Service",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 11},
        "targets": [
          {
            "expr": "hololoom_memory_usage_mb",
            "refId": "A",
            "legendFormat": "HoloLoom API"
          },
          {
            "expr": "emotion_memory_usage_mb",
            "refId": "B",
            "legendFormat": "Emotion Intelligence"
          }
        ],
        "yaxes": [
          {
            "format": "decmbytes",
            "label": "Memory",
            "logBase": 1,
            "show": true
          },
          {
            "format": "short",
            "logBase": 1,
            "show": false
          }
        ],
        "xaxis": {
          "mode": "time",
          "show": true
        },
        "lines": true,
        "fill": 2,
        "linewidth": 2,
        "points": false,
        "bars": false,
        "stack": false,
        "legend": {
          "show": true,
          "values": true,
          "min": false,
          "max": true,
          "current": true,
          "total": false,
          "avg": true
        }
      },
      {
        "id": 5,
        "title": "Cache Hit Rate",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 11},
        "targets": [
          {
            "expr": "rate(hololoom_cache_hits_total[5m]) / rate(hololoom_cache_requests_total[5m]) * 100",
            "refId": "A",
            "legendFormat": "Hit Rate %"
          }
        ],
        "yaxes": [
          {
            "format": "percent",
            "label": "Hit Rate",
            "logBase": 1,
            "show": true,
            "min": 0,
            "max": 100
          },
          {
            "format": "short",
            "logBase": 1,
            "show": false
          }
        ],
        "xaxis": {
          "mode": "time",
          "show": true
        },
        "lines": true,
        "fill": 3,
        "linewidth": 2,
        "points": false,
        "bars": false,
        "stack": false,
        "legend": {
          "show": true,
          "values": true,
          "min": true,
          "max": true,
          "current": true,
          "total": false,
          "avg": true
        },
        "thresholds": [
          {
            "value": 70,
            "colorMode": "critical",
            "op": "lt",
            "fill": true,
            "line": true,
            "yaxis": "left"
          }
        ]
      },
      {
        "id": 6,
        "title": "Query Complexity Distribution",
        "type": "bargauge",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 19},
        "targets": [
          {
            "expr": "hololoom_query_complexity_total",
            "refId": "A",
            "legendFormat": "{{complexity}}"
          }
        ],
        "options": {
          "orientation": "horizontal",
          "displayMode": "gradient",
          "showUnfilled": true
        },
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "palette-classic"},
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": null, "color": "green"}
              ]
            }
          }
        }
      },
      {
        "id": 7,
        "title": "Error Rate",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 19},
        "targets": [
          {
            "expr": "rate(hololoom_errors_total[5m])",
            "refId": "A",
            "legendFormat": "HoloLoom API Errors/s"
          },
          {
            "expr": "rate(emotion_requests_failed[5m])",
            "refId": "B",
            "legendFormat": "Emotion Intelligence Errors/s"
          }
        ],
        "yaxes": [
          {
            "format": "short",
            "label": "Errors/s",
            "logBase": 1,
            "show": true
          },
          {
            "format": "short",
            "logBase": 1,
            "show": false
          }
        ],
        "xaxis": {
          "mode": "time",
          "show": true
        },
        "lines": true,
        "fill": 1,
        "linewidth": 2,
        "points": true,
        "bars": false,
        "stack": false,
        "legend": {
          "show": true,
          "values": true,
          "min": false,
          "max": true,
          "current": true,
          "total": true,
          "avg": true
        },
        "alert": {
          "conditions": [
            {
              "evaluator": {
                "params": [0.1],
                "type": "gt"
              },
              "operator": {
                "type": "and"
              },
              "query": {
                "params": ["A", "5m", "now"]
              },
              "reducer": {
                "params": [],
                "type": "avg"
              },
              "type": "query"
            }
          ],
          "executionErrorState": "alerting",
          "for": "5m",
          "frequency": "1m",
          "message": "Error rate exceeds 0.1 errors/sec",
          "name": "High Error Rate Alert",
          "noDataState": "no_data",
          "notifications": []
        }
      },
      {
        "id": 8,
        "title": "Database Connections",
        "type": "stat",
        "gridPos": {"h": 4, "w": 12, "x": 0, "y": 27},
        "targets": [
          {
            "expr": "neo4j_active_connections",
            "refId": "A",
            "legendFormat": "Neo4j"
          },
          {
            "expr": "qdrant_active_connections",
            "refId": "B",
            "legendFormat": "Qdrant"
          }
        ],
        "options": {
          "colorMode": "value",
          "graphMode": "area",
          "justifyMode": "auto",
          "orientation": "auto",
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"],
            "fields": ""
          }
        },
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "thresholds"},
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": null, "color": "green"},
                {"value": 50, "color": "yellow"},
                {"value": 80, "color": "red"}
              ]
            }
          }
        }
      },
      {
        "id": 9,
        "title": "Storage Usage",
        "type": "stat",
        "gridPos": {"h": 4, "w": 12, "x": 12, "y": 27},
        "targets": [
          {
            "expr": "neo4j_store_size_mb",
            "refId": "A",
            "legendFormat": "Neo4j Store (MB)"
          },
          {
            "expr": "qdrant_vectors_count",
            "refId": "B",
            "legendFormat": "Qdrant Vectors"
          }
        ],
        "options": {
          "colorMode": "value",
          "graphMode": "area",
          "justifyMode": "auto",
          "orientation": "auto",
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"],
            "fields": ""
          }
        },
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "thresholds"},
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": null, "color": "green"}
              ]
            }
          }
        }
      }
    ]
  }
}
