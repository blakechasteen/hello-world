# Dockerfile for HoloLoom VoiceAgent Production Deployment
# ========================================================
# Multi-stage build for optimized production image
# Date: November 15, 2025

# Stage 1: Build stage
# --------------------
FROM python:3.10-slim as builder

# Set working directory
WORKDIR /build

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    make \
    git \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements first for better caching
COPY HoloLoom/voice/requirements.txt /build/voice-requirements.txt
COPY requirements.txt /build/hololoom-requirements.txt

# Create virtual environment
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Install Python dependencies
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r /build/hololoom-requirements.txt && \
    pip install --no-cache-dir -r /build/voice-requirements.txt


# Stage 2: Runtime stage
# ----------------------
FROM python:3.10-slim

# Metadata
LABEL maintainer="Blake Chasteen <blake@example.com>"
LABEL description="HoloLoom VoiceAgent - Production Voice Interaction Service"
LABEL version="1.0.0"

# Set environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    DEBIAN_FRONTEND=noninteractive \
    PATH="/opt/venv/bin:$PATH"

# Install runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    libavcodec-extra \
    libsndfile1 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy virtual environment from builder
COPY --from=builder /opt/venv /opt/venv

# Create non-root user for security
RUN groupadd -r hololoom && \
    useradd -r -g hololoom -u 1000 -m -s /bin/bash hololoom && \
    mkdir -p /app /data /logs && \
    chown -R hololoom:hololoom /app /data /logs

# Set working directory
WORKDIR /app

# Copy application code
COPY --chown=hololoom:hololoom HoloLoom/ /app/HoloLoom/
COPY --chown=hololoom:hololoom demos/ /app/demos/
COPY --chown=hololoom:hololoom *.py /app/

# Switch to non-root user
USER hololoom

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD python -c "from HoloLoom.voice import VoiceAgent; print('healthy')" || exit 1

# Expose port (if running as HTTP service)
EXPOSE 8000

# Default command - can be overridden
CMD ["python", "-m", "HoloLoom.voice.voice_agent"]


# Alternative entrypoint for demo mode
# CMD ["python", "demos/demo_voice_agent.py"]

# Alternative entrypoint for server mode
# CMD ["uvicorn", "HoloLoom.apps.server.voice_api:app", "--host", "0.0.0.0", "--port", "8000"]
