# HoloLoom Security Infrastructure Configuration
# Copy this file to .env.production, .env.staging, or .env.dev
# Fill in all values before deploying

# ============================================
# CRITICAL SECRETS (Generate with: openssl rand -hex 32)
# ============================================

# API Key Management Secret (256-bit)
# Used for: Generating and validating API keys
API_KEY_SECRET=

# User Hash Salt (256-bit)
# Used for: Hashing user IDs for privacy
USER_HASH_SALT=

# Encryption Key (256-bit)
# Used for: AES-256-GCM encryption of sensitive data
ENCRYPTION_KEY=

# JWT Secret (256-bit)
# Used for: Signing and verifying JWT tokens
JWT_SECRET=

# ============================================
# DATABASE PASSWORDS
# ============================================

# PostgreSQL (forensic logs, audit trail)
POSTGRES_USER=hololoom
POSTGRES_PASSWORD=

# Neo4j (knowledge graph, RBAC)
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Qdrant (vector storage) - Generate with: openssl rand -base64 32
QDRANT_API_KEY=

# ============================================
# OAUTH2 PROVIDERS
# ============================================

# Auth0 (https://auth0.com)
OAUTH2_AUTH0_CLIENT_ID=
OAUTH2_AUTH0_CLIENT_SECRET=
OAUTH2_AUTH0_DOMAIN=your-tenant.auth0.com

# Okta (https://okta.com)
OAUTH2_OKTA_CLIENT_ID=
OAUTH2_OKTA_CLIENT_SECRET=
OAUTH2_OKTA_DOMAIN=your-domain.okta.com

# Google OAuth
OAUTH2_GOOGLE_CLIENT_ID=
OAUTH2_GOOGLE_CLIENT_SECRET=

# GitHub OAuth
OAUTH2_GITHUB_CLIENT_ID=
OAUTH2_GITHUB_CLIENT_SECRET=

# ============================================
# SIEM BACKEND
# ============================================

# Choose: splunk, elk, datadog
SIEM_BACKEND=splunk

# Splunk (https://splunk.com)
SPLUNK_PASSWORD=
SPLUNK_HEC_TOKEN=  # Generate in Splunk: Settings > Data Inputs > HTTP Event Collector

# Datadog (https://datadoghq.com)
DATADOG_API_KEY=
DATADOG_APP_KEY=

# ELK Stack (Elasticsearch)
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=

# ============================================
# ALERTING CHANNELS
# ============================================

# Slack
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_CHANNEL=#security-alerts

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=alerts@hololoom.local

# PagerDuty
PAGERDUTY_API_KEY=
PAGERDUTY_SERVICE_ID=

# Twilio (SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=+1234567890
TWILIO_TO_PHONE=+1234567890

# ============================================
# MONITORING & DASHBOARDS
# ============================================

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# Prometheus
PROMETHEUS_RETENTION=15d

# ============================================
# APPLICATION CONFIGURATION
# ============================================

# Environment: dev, staging, production
ENVIRONMENT=staging

# Log Level: debug, info, warning, error
LOG_LEVEL=info

# Number of API workers
WORKERS=4

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# Session Configuration
SESSION_TIMEOUT_MINUTES=30
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://app.hololoom.local

# ============================================
# COMPLIANCE CONFIGURATION
# ============================================

# Data Retention (days)
FORENSIC_LOG_HOT_RETENTION=7
FORENSIC_LOG_WARM_RETENTION=30
FORENSIC_LOG_COLD_RETENTION=90

# Audit Log Retention
AUDIT_LOG_RETENTION_DAYS=365

# GDPR Settings
GDPR_DSR_SLA_DAYS=30
GDPR_BREACH_NOTIFICATION_HOURS=72

# ============================================
# OPTIONAL FEATURES
# ============================================

# Enable features
ENABLE_ML_ANOMALY_DETECTION=true
ENABLE_SOAR_AUTOMATION=true
ENABLE_FORENSIC_LOGGING=true
ENABLE_COMPLIANCE_MONITORING=true

# ML Model Configuration
ANOMALY_DETECTION_MODELS=isolation_forest,lstm,autoencoder
ANOMALY_BASELINE_DAYS=7

# ============================================
# INFRASTRUCTURE SCALING
# ============================================

# Redis
REDIS_MAX_MEMORY=512mb
REDIS_MAX_MEMORY_POLICY=allkeys-lru

# PostgreSQL
POSTGRES_MAX_CONNECTIONS=100
POSTGRES_SHARED_BUFFERS=256MB

# Neo4j
NEO4J_HEAP_INITIAL_SIZE=512M
NEO4J_HEAP_MAX_SIZE=2G
NEO4J_PAGECACHE_SIZE=1G

# ============================================
# BACKUP CONFIGURATION
# ============================================

# Backup Schedule (cron format)
BACKUP_SCHEDULE=0 2 * * *  # 2 AM daily

# Backup Retention
BACKUP_RETENTION_DAYS=30

# S3 Backup (optional)
S3_BACKUP_ENABLED=false
S3_BUCKET=hololoom-backups
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ============================================
# SSL/TLS CONFIGURATION
# ============================================

# Use Let's Encrypt for SSL (production only)
LETSENCRYPT_ENABLED=false
LETSENCRYPT_EMAIL=admin@hololoom.local
LETSENCRYPT_DOMAIN=hololoom.local

# ============================================
# FEATURE FLAGS
# ============================================

# Experimental Features
ENABLE_ZERO_COPY_EMBEDDINGS=true
ENABLE_PHASE5_LINGUISTICS=true
ENABLE_RECURSIVE_LEARNING=true

# Security Features
ENABLE_WAF=true
ENABLE_RATE_LIMITING=true
ENABLE_IP_REPUTATION=true
ENABLE_HUMAN_IN_LOOP=true  # For high-risk actions

# ============================================
# DEVELOPMENT ONLY (DO NOT USE IN PRODUCTION)
# ============================================

# Debug Mode (NEVER enable in production)
DEBUG=false

# Disable Security (DEVELOPMENT ONLY)
DISABLE_OAUTH2=false
DISABLE_RBAC=false
DISABLE_WAF=false
DISABLE_RATE_LIMITING=false

# ============================================
# NOTES
# ============================================

# To generate secure random values:
#   openssl rand -hex 32        # For secrets
#   openssl rand -base64 32     # For API keys
#   pwgen -s 32 1               # Alternative password generator

# Minimum security requirements for production:
#   - All CRITICAL SECRETS must be unique 256-bit values
#   - All DATABASE PASSWORDS must be strong (20+ chars)
#   - ENVIRONMENT must be set to "production"
#   - DEBUG must be false
#   - All DISABLE_* flags must be false
#   - SSL/TLS certificates must be valid (not self-signed)
#   - At least 2 alerting channels configured

# Compliance requirements:
#   - FORENSIC_LOG_COLD_RETENTION >= 90 days (SOC2)
#   - AUDIT_LOG_RETENTION_DAYS >= 365 days (SOC2, ISO 27001)
#   - GDPR_BREACH_NOTIFICATION_HOURS = 72 (GDPR Article 33)
#   - Backup retention >= 30 days (business continuity)
