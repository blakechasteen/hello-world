# HoloLoom Production Dockerfile
# ================================
# Multi-stage build with security hardening for production deployment
# Target SLA: 99.9% uptime, 10,000 concurrent users
# Date: November 17, 2025

# ==============================================================================
# Stage 1: Builder - Install dependencies and compile native extensions
# ==============================================================================
FROM python:3.11-slim AS builder

# Metadata
LABEL maintainer="hololoom@example.com"
LABEL version="1.0.0"
LABEL description="HoloLoom production builder stage"

WORKDIR /build

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    git \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements first (leverage Docker cache)
COPY requirements.txt .
COPY HoloLoom/requirements.txt ./HoloLoom/

# Create virtual environment
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Install Python dependencies
RUN pip install --no-cache-dir --upgrade pip setuptools wheel && \
    pip install --no-cache-dir -r requirements.txt

# Install production dependencies
RUN pip install --no-cache-dir \
    uvicorn[standard]>=0.24.0 \
    fastapi>=0.104.0 \
    pydantic>=2.5.0 \
    python-multipart>=0.0.6 \
    prometheus-client>=0.19.0 \
    psutil>=5.9.0 \
    rich>=13.7.0

# Install production backends (Neo4j + Qdrant)
RUN pip install --no-cache-dir \
    neo4j>=5.14.0 \
    qdrant-client>=1.7.0

# Install spaCy model for NLP features
RUN python -m spacy download en_core_web_sm

# ==============================================================================
# Stage 2: Runtime - Minimal production image
# ==============================================================================
FROM python:3.11-slim

# Metadata
LABEL maintainer="hololoom@example.com"
LABEL version="1.0.0"
LABEL description="HoloLoom production runtime"

# Security: Create non-root user
RUN groupadd -r hololoom --gid=1000 && \
    useradd -r -g hololoom --uid=1000 --home-dir=/app --shell=/bin/bash hololoom

WORKDIR /app

# Install runtime dependencies only
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgomp1 \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy virtual environment from builder
COPY --from=builder /opt/venv /opt/venv

# Copy application code
COPY --chown=hololoom:hololoom HoloLoom/ ./HoloLoom/
COPY --chown=hololoom:hololoom demos/ ./demos/
COPY --chown=hololoom:hololoom requirements.txt ./
COPY --chown=hololoom:hololoom README.md CLAUDE.md ./

# Create directories with proper permissions
RUN mkdir -p /app/logs /app/data /app/checkpoints /app/.cache && \
    chown -R hololoom:hololoom /app

# Set environment variables
ENV PATH="/opt/venv/bin:$PATH"
ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1
ENV LOGLEVEL=INFO
ENV PROMETHEUS_MULTIPROC_DIR=/app/.prometheus

# Production environment variables
ENV HOLOLOOM_ENV=production
ENV HOLOLOOM_CONFIG=Config.fast()
ENV HOLOLOOM_MEMORY_BACKEND=HYBRID

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Expose ports
EXPOSE 8000

# Switch to non-root user
USER hololoom

# Start server
CMD ["uvicorn", "HoloLoom.server.unified_server:app", \
     "--host", "0.0.0.0", \
     "--port", "8000", \
     "--workers", "4", \
     "--log-level", "info"]
