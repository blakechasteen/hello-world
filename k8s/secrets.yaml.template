# EdWIN Kubernetes Secrets (TEMPLATE)
# DO NOT commit actual secrets to git!
#
# Usage:
#   1. Copy this file: cp secrets.yaml.template secrets.yaml
#   2. Fill in actual values (base64 encoded)
#   3. Apply: kubectl apply -f k8s/secrets.yaml
#   4. Add secrets.yaml to .gitignore
#
# To encode: echo -n "your-password" | base64
#
# Implementation Date: November 15, 2025

apiVersion: v1
kind: Secret
metadata:
  name: edwin-secrets
  namespace: edwin
  labels:
    app: edwin
    component: secrets
type: Opaque
data:
  # Neo4j (base64 encoded)
  NEO4J_PASSWORD: "REPLACE_WITH_BASE64_ENCODED_PASSWORD"  # e.g., cGFzc3dvcmQxMjM=

  # JWT Secret Key (base64 encoded)
  JWT_SECRET_KEY: "REPLACE_WITH_BASE64_ENCODED_SECRET"  # e.g., generate with: openssl rand -base64 32 | base64

  # Redis Password (optional, base64 encoded)
  REDIS_PASSWORD: ""  # Leave empty if no password

  # API Keys (base64 encoded)
  ANTHROPIC_API_KEY: ""  # Optional for LLM features
  OPENAI_API_KEY: ""     # Optional for LLM features
