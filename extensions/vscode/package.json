{
  "name": "squad",
  "displayName": "Squad - hololoom Agent API",
  "description": "Agentic coding assistant powered by hololoom's multi-step reasoning",
  "version": "0.1.0",
  "publisher": "hololoom",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Machine Learning",
    "Education"
  ],
  "keywords": ["ai", "agent", "reasoning", "hololoom", "assistant"],
  "activationEvents": ["onStartupFinished"],
  "main": "./out/extension.js",
  "contributes": {
    "views": {
      "explorer": [
        {
          "id": "hololoomAgents",
          "name": "hololoom Agents",
          "icon": "$(pulse)",
          "contextualTitle": "Agent Monitoring"
        },
        {
          "id": "hololoomSkills",
          "name": "hololoom Skills",
          "icon": "$(extensions)",
          "contextualTitle": "Installed Skills"
        }
      ]
    },
    "commands": [
      {
        "command": "squad.ask",
        "title": "Squad: Ask Question",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "squad.explainSelection",
        "title": "Squad: Explain Selection",
        "icon": "$(book)"
      },
      {
        "command": "squad.suggestFix",
        "title": "Squad: Suggest Fix",
        "icon": "$(lightbulb)"
      },
      {
        "command": "squad.refactor",
        "title": "Squad: Refactor Code",
        "icon": "$(symbol-method)"
      },
      {
        "command": "squad.generateTests",
        "title": "Squad: Generate Tests",
        "icon": "$(beaker)"
      },
      {
        "command": "squad.openPanel",
        "title": "Squad: Open Agent Panel",
        "icon": "$(output)"
      },
      {
        "command": "hololoom.refreshAgentMonitor",
        "title": "hololoom: Refresh Agent Monitor",
        "icon": "$(refresh)"
      },
      {
        "command": "hololoom.showAgentDetails",
        "title": "hololoom: Show Agent Details"
      },
      {
        "command": "skills.openExplorer",
        "title": "Skills: Open Marketplace",
        "icon": "$(extensions)"
      },
      {
        "command": "skills.refresh",
        "title": "Skills: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "skills.invoke",
        "title": "Skills: Invoke Skill"
      },
      {
        "command": "skills.install",
        "title": "Skills: Install Skill"
      },
      {
        "command": "skills.remove",
        "title": "Skills: Remove Skill"
      },
      {
        "command": "skills.enable",
        "title": "Skills: Enable Skill"
      },
      {
        "command": "skills.disable",
        "title": "Skills: Disable Skill"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "hololoom.refreshAgentMonitor",
          "when": "view == hololoomAgents",
          "group": "navigation"
        },
        {
          "command": "skills.refresh",
          "when": "view == hololoomSkills",
          "group": "navigation"
        },
        {
          "command": "skills.openExplorer",
          "when": "view == hololoomSkills",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "skills.invoke",
          "when": "view == hololoomSkills && viewItem == skillInstalled",
          "group": "inline"
        },
        {
          "command": "skills.disable",
          "when": "view == hololoomSkills && viewItem == skillInstalled",
          "group": "skill@1"
        },
        {
          "command": "skills.enable",
          "when": "view == hololoomSkills && viewItem == skillDisabled",
          "group": "skill@1"
        },
        {
          "command": "skills.remove",
          "when": "view == hololoomSkills && (viewItem == skillInstalled || viewItem == skillDisabled)",
          "group": "skill@2"
        }
      ]
    },
    "keybindings": [
      {
        "command": "squad.ask",
        "key": "ctrl+shift+q",
        "mac": "cmd+shift+q"
      },
      {
        "command": "squad.explainSelection",
        "key": "ctrl+shift+e",
        "mac": "cmd+shift+e",
        "when": "editorTextFocus"
      }
    ],
    "configuration": {
      "title": "Squad",
      "properties": {
        "squad.serverUrl": {
          "type": "string",
          "default": "http://localhost:8000",
          "description": "Squad agent API server URL"
        },
        "squad.reasoningMode": {
          "type": "string",
          "enum": ["direct", "verify", "research", "plan_execute"],
          "default": "verify",
          "description": "Default reasoning mode"
        },
        "squad.maxSteps": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "maximum": 10,
          "description": "Maximum reasoning steps"
        },
        "squad.showReasoningSteps": {
          "type": "boolean",
          "default": true,
          "description": "Show intermediate reasoning steps"
        },
        "skills.marketplaceUrl": {
          "type": "string",
          "default": "http://localhost:8080",
          "description": "Skills Marketplace API URL"
        },
        "skills.autoUpdate": {
          "type": "boolean",
          "default": true,
          "description": "Automatically check for skill updates"
        },
        "skills.showNotifications": {
          "type": "boolean",
          "default": true,
          "description": "Show notifications for skill events"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.x",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "axios": "^1.6.2",
    "ws": "^8.14.2",
    "@types/ws": "^8.5.10"
  }
}
