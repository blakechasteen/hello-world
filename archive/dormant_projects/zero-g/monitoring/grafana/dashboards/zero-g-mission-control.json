{
  "dashboard": {
    "id": null,
    "uid": "zerog-mission-control",
    "title": "Zero-G Mission Control",
    "tags": ["zero-g", "mission-control"],
    "timezone": "browser",
    "schemaVersion": 38,
    "version": 1,
    "refresh": "10s",
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "panels": [
      {
        "id": 1,
        "title": "Launch Status",
        "type": "gauge",
        "gridPos": {
          "h": 8,
          "w": 6,
          "x": 0,
          "y": 0
        },
        "targets": [
          {
            "expr": "up{job=\"zerog-backend\"}",
            "refId": "A",
            "legendFormat": "Backend Status"
          }
        ],
        "options": {
          "orientation": "auto",
          "showThresholdLabels": false,
          "showThresholdMarkers": true
        },
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "min": 0,
            "max": 1,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "value": 0,
                  "color": "red"
                },
                {
                  "value": 1,
                  "color": "green"
                }
              ]
            },
            "mappings": [
              {
                "type": "value",
                "options": {
                  "0": {
                    "text": "DOWN"
                  },
                  "1": {
                    "text": "OPERATIONAL"
                  }
                }
              }
            ]
          }
        }
      },
      {
        "id": 2,
        "title": "System Health",
        "type": "stat",
        "gridPos": {
          "h": 8,
          "w": 18,
          "x": 6,
          "y": 0
        },
        "targets": [
          {
            "expr": "up{job=\"zerog-backend\"}",
            "refId": "A",
            "legendFormat": "Backend"
          },
          {
            "expr": "up{job=\"neo4j\"}",
            "refId": "B",
            "legendFormat": "Neo4j"
          },
          {
            "expr": "up{job=\"qdrant\"}",
            "refId": "C",
            "legendFormat": "Qdrant"
          },
          {
            "expr": "up{job=\"prometheus\"}",
            "refId": "D",
            "legendFormat": "Prometheus"
          }
        ],
        "options": {
          "orientation": "auto",
          "textMode": "value_and_name",
          "colorMode": "background",
          "graphMode": "none",
          "justifyMode": "auto"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "value": 0,
                  "color": "red"
                },
                {
                  "value": 1,
                  "color": "green"
                }
              ]
            },
            "mappings": [
              {
                "type": "value",
                "options": {
                  "0": {
                    "text": "DOWN"
                  },
                  "1": {
                    "text": "UP"
                  }
                }
              }
            ]
          }
        }
      },
      {
        "id": 3,
        "title": "Request Latency (ms)",
        "type": "timeseries",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 8
        },
        "targets": [
          {
            "expr": "histogram_quantile(0.50, sum(rate(zerog_request_duration_seconds_bucket[5m])) by (le)) * 1000",
            "refId": "A",
            "legendFormat": "p50"
          },
          {
            "expr": "histogram_quantile(0.95, sum(rate(zerog_request_duration_seconds_bucket[5m])) by (le)) * 1000",
            "refId": "B",
            "legendFormat": "p95"
          },
          {
            "expr": "histogram_quantile(0.99, sum(rate(zerog_request_duration_seconds_bucket[5m])) by (le)) * 1000",
            "refId": "C",
            "legendFormat": "p99"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "ms",
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "smooth",
              "fillOpacity": 10,
              "showPoints": "never"
            }
          }
        },
        "options": {
          "tooltip": {
            "mode": "multi"
          },
          "legend": {
            "displayMode": "table",
            "placement": "bottom",
            "calcs": ["mean", "last", "max"]
          }
        }
      },
      {
        "id": 4,
        "title": "Error Rate",
        "type": "timeseries",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 8
        },
        "targets": [
          {
            "expr": "sum(rate(zerog_requests_total{status=~\"5..\"}[5m])) / sum(rate(zerog_requests_total[5m]))",
            "refId": "A",
            "legendFormat": "Error Rate"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit",
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "smooth",
              "fillOpacity": 20,
              "showPoints": "never"
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "value": 0,
                  "color": "green"
                },
                {
                  "value": 0.01,
                  "color": "yellow"
                },
                {
                  "value": 0.05,
                  "color": "red"
                }
              ]
            }
          }
        }
      },
      {
        "id": 5,
        "title": "Active Astronauts",
        "type": "stat",
        "gridPos": {
          "h": 6,
          "w": 6,
          "x": 0,
          "y": 16
        },
        "targets": [
          {
            "expr": "zerog_active_astronauts",
            "refId": "A"
          }
        ],
        "options": {
          "textMode": "value_and_name",
          "colorMode": "value",
          "graphMode": "area",
          "justifyMode": "auto"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "value": 0,
                  "color": "red"
                },
                {
                  "value": 1,
                  "color": "yellow"
                },
                {
                  "value": 5,
                  "color": "green"
                }
              ]
            }
          }
        }
      },
      {
        "id": 6,
        "title": "Connected Data Sources",
        "type": "stat",
        "gridPos": {
          "h": 6,
          "w": 6,
          "x": 6,
          "y": 16
        },
        "targets": [
          {
            "expr": "zerog_connected_data_sources",
            "refId": "A"
          }
        ],
        "options": {
          "textMode": "value_and_name",
          "colorMode": "value",
          "graphMode": "area",
          "justifyMode": "auto"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "value": 0,
                  "color": "red"
                },
                {
                  "value": 1,
                  "color": "yellow"
                },
                {
                  "value": 3,
                  "color": "green"
                }
              ]
            }
          }
        }
      },
      {
        "id": 7,
        "title": "Requests per Second",
        "type": "timeseries",
        "gridPos": {
          "h": 6,
          "w": 12,
          "x": 12,
          "y": 16
        },
        "targets": [
          {
            "expr": "sum(rate(zerog_requests_total[1m]))",
            "refId": "A",
            "legendFormat": "Total RPS"
          },
          {
            "expr": "sum(rate(zerog_requests_total{status=~\"2..\"}[1m]))",
            "refId": "B",
            "legendFormat": "Success (2xx)"
          },
          {
            "expr": "sum(rate(zerog_requests_total{status=~\"4..\"}[1m]))",
            "refId": "C",
            "legendFormat": "Client Errors (4xx)"
          },
          {
            "expr": "sum(rate(zerog_requests_total{status=~\"5..\"}[1m]))",
            "refId": "D",
            "legendFormat": "Server Errors (5xx)"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "reqps",
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "smooth",
              "fillOpacity": 10
            }
          }
        }
      },
      {
        "id": 8,
        "title": "Memory Usage",
        "type": "timeseries",
        "gridPos": {
          "h": 6,
          "w": 12,
          "x": 0,
          "y": 22
        },
        "targets": [
          {
            "expr": "process_resident_memory_bytes{job=\"zerog-backend\"} / 1024 / 1024",
            "refId": "A",
            "legendFormat": "Backend (MB)"
          },
          {
            "expr": "neo4j_memory_heap_used_bytes{job=\"neo4j\"} / 1024 / 1024",
            "refId": "B",
            "legendFormat": "Neo4j Heap (MB)"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "decmbytes",
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "smooth",
              "fillOpacity": 10
            }
          }
        }
      },
      {
        "id": 9,
        "title": "Graph Database Stats",
        "type": "stat",
        "gridPos": {
          "h": 6,
          "w": 12,
          "x": 12,
          "y": 22
        },
        "targets": [
          {
            "expr": "neo4j_node_count",
            "refId": "A",
            "legendFormat": "Nodes"
          },
          {
            "expr": "neo4j_relationship_count",
            "refId": "B",
            "legendFormat": "Relationships"
          },
          {
            "expr": "qdrant_collection_vectors_count",
            "refId": "C",
            "legendFormat": "Vectors"
          }
        ],
        "options": {
          "textMode": "value_and_name",
          "colorMode": "none",
          "graphMode": "area"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "short"
          }
        }
      }
    ]
  }
}
