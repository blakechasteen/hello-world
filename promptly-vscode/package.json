{
  "name": "promptly",
  "displayName": "Promptly",
  "description": "Chat-native development with slash commands",
  "version": "0.1.0",
  "publisher": "promptly",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "hololoom",
          "title": "HoloLoom",
          "icon": "$(brain)"
        }
      ]
    },
    "views": {
      "hololoom": [
        {
          "type": "webview",
          "id": "promptly.hololoomSidebar",
          "name": "Memory",
          "icon": "$(brain)",
          "contextualTitle": "HoloLoom Memory"
        }
      ]
    },
    "commands": [
      {
        "command": "promptly.chat",
        "title": "Promptly: Open Chat"
      },
      {
        "command": "promptly.gitStatus",
        "title": "Promptly: Git Status"
      },
      {
        "command": "promptly.gitCommit",
        "title": "Promptly: Git Commit"
      },
      {
        "command": "promptly.gitPush",
        "title": "Promptly: Git Push"
      },
      {
        "command": "promptly.gitLog",
        "title": "Promptly: Git Log"
      },
      {
        "command": "promptly.review",
        "title": "Promptly: Review Code"
      },
      {
        "command": "promptly.explain",
        "title": "Promptly: Explain Code"
      },
      {
        "command": "promptly.remember",
        "title": "Promptly: Remember (HoloLoom)"
      },
      {
        "command": "promptly.recall",
        "title": "Promptly: Recall (HoloLoom)"
      },
      {
        "command": "promptly.indexWorkspace",
        "title": "HoloLoom: Index Workspace"
      },
      {
        "command": "promptly.indexingStatus",
        "title": "HoloLoom: Show Indexing Status"
      },
      {
        "command": "promptly.showGraph",
        "title": "HoloLoom: Show Knowledge Graph"
      },
      {
        "command": "promptly.restartLSP",
        "title": "HoloLoom: Restart LSP Server"
      },
      {
        "command": "promptly.lspStatus",
        "title": "HoloLoom: Show LSP Status"
      }
    ],
    "keybindings": [
      {
        "command": "promptly.chat",
        "key": "ctrl+alt+p",
        "mac": "cmd+alt+p"
      }
    ],
    "configuration": {
      "title": "Promptly",
      "properties": {
        "promptly.hololoomUrl": {
          "type": "string",
          "default": "http://localhost:8000",
          "description": "HoloLoom server URL"
        },
        "promptly.claudeApiKey": {
          "type": "string",
          "default": "",
          "description": "Anthropic API key for Claude (optional)"
        },
        "promptly.enableAutocomplete": {
          "type": "boolean",
          "default": true,
          "description": "Enable slash command autocomplete in chat"
        },
        "hololoom.lsp.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable HoloLoom Language Server Protocol client"
        },
        "hololoom.lsp.pythonPath": {
          "type": "string",
          "default": "",
          "description": "Path to Python interpreter for LSP server (auto-detected if not set)"
        },
        "hololoom.lsp.hololoomPath": {
          "type": "string",
          "default": "",
          "description": "Path to HoloLoom installation (auto-detected if not set)"
        },
        "hololoom.lsp.logLevel": {
          "type": "string",
          "enum": [
            "DEBUG",
            "INFO",
            "WARNING",
            "ERROR"
          ],
          "default": "INFO",
          "description": "LSP server log level"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "vscode-languageclient": "^9.0.1"
  }
}
