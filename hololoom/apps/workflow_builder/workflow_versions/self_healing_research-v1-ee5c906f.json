{
  "version_id": "self_healing_research-v1-ee5c906f",
  "workflow_id": "self_healing_research",
  "version_number": 1,
  "workflow_data": {
    "version": "1.0",
    "name": "Self-Healing Research Pipeline",
    "description": "Uses Thompson Sampling to dynamically select best strategy based on query characteristics. Automatically heals low-confidence paths.",
    "tags": [
      "research",
      "adaptive",
      "thompson-sampling",
      "self-healing"
    ],
    "author": "hololoom Team",
    "created": "2025-12-23",
    "nodes": [
      {
        "id": "classify_query",
        "agentType": "hololoom",
        "x": 100,
        "y": 200,
        "config": {
          "pattern": "bare",
          "purpose": "Classify query complexity and type"
        }
      },
      {
        "id": "strategy_selector",
        "agentType": "thompson",
        "x": 250,
        "y": 200,
        "config": {
          "description": "Select optimal research strategy via Thompson Sampling"
        }
      },
      {
        "id": "deep_research",
        "agentType": "multiquery",
        "x": 400,
        "y": 100,
        "config": {
          "num_queries": 5,
          "description": "Break into 5 sub-questions for comprehensive research"
        }
      },
      {
        "id": "fast_lookup",
        "agentType": "search",
        "x": 400,
        "y": 200,
        "config": {
          "k": 10,
          "strategy": "similar",
          "description": "Quick semantic search for simple queries"
        }
      },
      {
        "id": "graph_exploration",
        "agentType": "fusion",
        "x": 400,
        "y": 300,
        "config": {
          "max_hops": 3,
          "description": "Multi-hop knowledge graph traversal"
        }
      },
      {
        "id": "synthesize_results",
        "agentType": "synthesizer",
        "x": 550,
        "y": 200,
        "config": {
          "description": "Extract entities and motifs from research results"
        }
      },
      {
        "id": "quality_check",
        "agentType": "convergence",
        "x": 700,
        "y": 200,
        "config": {
          "strategy": "bayesian_blend",
          "description": "Assess quality of synthesized results"
        }
      },
      {
        "id": "confidence_gate",
        "agentType": "conditional",
        "x": 850,
        "y": 200,
        "config": {
          "condition": "confidence >= 0.75",
          "threshold": 0.75
        }
      },
      {
        "id": "heal_with_refinement",
        "agentType": "refiner",
        "x": 1000,
        "y": 300,
        "config": {
          "strategy": "verify",
          "max_iterations": 3,
          "quality_threshold": 0.8,
          "description": "Self-healing: refine low-quality results"
        }
      },
      {
        "id": "final_response",
        "agentType": "response",
        "x": 1000,
        "y": 100,
        "config": {
          "format": "markdown"
        }
      },
      {
        "id": "update_bandit",
        "agentType": "store",
        "x": 1150,
        "y": 200,
        "config": {
          "description": "Store outcome to update Thompson Sampling priors"
        }
      }
    ],
    "connections": [
      {
        "id": "c1",
        "from": "classify_query",
        "to": "strategy_selector"
      },
      {
        "id": "c2",
        "from": "strategy_selector",
        "to": "deep_research",
        "condition": "${strategy_selector.selected} == 'deep_research'"
      },
      {
        "id": "c3",
        "from": "strategy_selector",
        "to": "fast_lookup",
        "condition": "${strategy_selector.selected} == 'fast_lookup'"
      },
      {
        "id": "c4",
        "from": "strategy_selector",
        "to": "graph_exploration",
        "condition": "${strategy_selector.selected} == 'graph_exploration'"
      },
      {
        "id": "c5",
        "from": "deep_research",
        "to": "synthesize_results"
      },
      {
        "id": "c6",
        "from": "fast_lookup",
        "to": "synthesize_results"
      },
      {
        "id": "c7",
        "from": "graph_exploration",
        "to": "synthesize_results"
      },
      {
        "id": "c8",
        "from": "synthesize_results",
        "to": "quality_check"
      },
      {
        "id": "c9",
        "from": "quality_check",
        "to": "confidence_gate"
      },
      {
        "id": "c10",
        "from": "confidence_gate",
        "to": "final_response",
        "condition": "true"
      },
      {
        "id": "c11",
        "from": "confidence_gate",
        "to": "heal_with_refinement",
        "condition": "false"
      },
      {
        "id": "c12",
        "from": "heal_with_refinement",
        "to": "final_response"
      },
      {
        "id": "c13",
        "from": "final_response",
        "to": "update_bandit"
      }
    ],
    "input_schema": {
      "query": {
        "type": "string",
