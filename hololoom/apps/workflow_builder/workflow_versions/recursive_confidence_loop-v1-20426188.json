  "version_number": 1,
  "workflow_data": {
    "version": "1.0",
    "name": "Recursive Confidence Loop",
    "description": "Iteratively refines answer until confidence threshold is met or max iterations reached. Demonstrates loop control flow with dynamic exit conditions.",
    "tags": [
      "recursive",
      "loop",
      "refinement",
      "quality-control"
    ],
    "author": "HoloLoom Team",
    "created": "2025-12-23",
    "nodes": [
      {
        "id": "initial_query",
        "agentType": "hololoom",
        "x": 100,
        "y": 200,
        "config": {
          "pattern": "fast",
          "description": "Generate initial answer"
        }
      },
      {
        "id": "loop_controller",
        "agentType": "loop",
        "x": 250,
        "y": 200,
        "config": {
          "max_iterations": 5,
          "break_condition": "confidence >= 0.85 OR iterations >= 5",
          "description": "Control refinement iterations"
        }
      },
      {
        "id": "quality_assessment",
        "agentType": "convergence",
        "x": 400,
        "y": 200,
        "config": {
          "strategy": "bayesian_blend",
          "description": "Assess current answer quality"
        }
      },
      {
        "id": "needs_improvement",
        "agentType": "conditional",
        "x": 550,
        "y": 200,
        "config": {
          "condition": "confidence < 0.85",
          "threshold": 0.85
        }
      },
      {
        "id": "identify_weakness",
        "agentType": "synthesizer",
        "x": 700,
        "y": 300,
        "config": {
          "extract_type": "weaknesses",
          "description": "Identify specific weaknesses to address"
        }
      },
      {
        "id": "targeted_search",
        "agentType": "search",
        "x": 850,
        "y": 300,
        "config": {
          "k": 5,
          "strategy": "connected",
          "description": "Search for information to address weaknesses"
        }
      },
      {
        "id": "refinement_step",
        "agentType": "refiner",
        "x": 1000,
        "y": 300,
        "config": {
          "strategy": "verify",
          "max_iterations": 1,
          "description": "Single refinement iteration"
        }
      },
      {
        "id": "update_answer",
        "agentType": "hololoom",
        "x": 1150,
        "y": 300,
        "config": {
          "pattern": "fast",
          "description": "Integrate refinements into answer"
        }
      },
      {
        "id": "final_output",
        "agentType": "response",
        "x": 700,
        "y": 100,
        "config": {
          "format": "markdown",
          "include_metadata": true
        }
      },
      {
        "id": "log_iterations",
        "agentType": "store",
        "x": 850,
        "y": 100,
        "config": {
          "description": "Log iteration history for analysis"
        }
      }
    ],
    "connections": [
      {
        "id": "c1",
        "from": "initial_query",
        "to": "loop_controller"
      },
