        "condition": "false"
      },
      {
        "id": "c10",
        "from": "has_major_disagreement",
        "to": "resolution_search",
        "condition": "true"
      },
      {
        "id": "c11",
        "from": "resolution_search",
        "to": "arbiter_decision"
      },
      {
        "id": "c12",
        "from": "arbiter_decision",
        "to": "merge_results"
      },
      {
        "id": "c13",
        "from": "verify_claims",
        "to": "merge_results"
      },
      {
        "id": "c14",
        "from": "merge_results",
        "to": "final_synthesis"
      },
      {
        "id": "c15",
        "from": "final_synthesis",
        "to": "audit_log"
      }
    ],
