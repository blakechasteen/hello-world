        "from": "adversarial_critique",
        "to": "extract_critiques"
      },
      {
        "id": "c5",
        "from": "extract_claims",
        "to": "verify_claims"
      },
      {
        "id": "c6",
        "from": "extract_claims",
        "to": "disagreement_detector"
      },
      {
        "id": "c7",
        "from": "extract_critiques",
        "to": "disagreement_detector"
      },
      {
        "id": "c8",
        "from": "disagreement_detector",
        "to": "has_major_disagreement"
      },
      {
        "id": "c9",
        "from": "has_major_disagreement",
