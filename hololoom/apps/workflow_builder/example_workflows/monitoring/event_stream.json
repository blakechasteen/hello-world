{
  "version": "1.0",
  "name": "Event Stream Processing & Alerting",
  "description": "A real-time event processing workflow with sliding window aggregation, parallel anomaly detection across multiple dimensions, alert classification with severity routing, deduplication to prevent alert storms, and multi-channel notification delivery with runbook suggestions.",
  "tags": ["streaming", "events", "alerting", "monitoring", "anomaly-detection", "real-time", "observability"],
  "author": "HoloLoom Team",
  "created": "2025-12-28",
  "nodes": [
    {
      "id": "stream_ingester",
      "agentType": "store",
      "x": 100,
      "y": 250,
      "config": {
        "store_type": "stream_input",
        "sources": ["kafka", "kinesis", "pubsub", "webhook"],
        "buffer_size": 10000,
        "batch_timeout_ms": 100,
        "deserializer": "json"
      }
    },
    {
      "id": "event_parser",
      "agentType": "synthesizer",
      "x": 250,
      "y": 250,
      "config": {
        "extract_type": "event_parsing",
        "schema_registry": true,
        "timestamp_field": "event_time",
        "normalize_fields": true,
        "drop_malformed": true
      }
    },
    {
      "id": "window_aggregator",
      "agentType": "fusion",
      "x": 400,
      "y": 250,
      "config": {
        "strategy": "sliding_window",
        "window_size_seconds": 60,
        "slide_interval_seconds": 10,
        "aggregations": ["count", "sum", "avg", "min", "max", "p95", "p99"],
        "group_by": ["service", "region", "endpoint"]
      }
    },
    {
      "id": "parallel_analyzers",
      "agentType": "parallel",
      "x": 550,
      "y": 250,
      "config": {
        "strategy": "fan_out",
        "timeout_ms": 5000,
        "collect_all": true,
        "fail_fast": false
      }
    },
    {
      "id": "pattern_analyzer",
      "agentType": "hololoom",
      "x": 700,
      "y": 100,
      "config": {
        "pattern": "fast",
        "mode": "pattern_detection",
        "patterns": ["spike", "drop", "flatline", "oscillation", "trend_change"],
        "sensitivity": 0.8,
        "min_duration_seconds": 30
      }
    },
    {
      "id": "anomaly_detector",
      "agentType": "hololoom",
      "x": 700,
      "y": 200,
      "config": {
        "pattern": "fused",
        "mode": "anomaly_detection",
        "algorithms": ["isolation_forest", "z_score", "mad", "ewma"],
        "threshold_sigma": 3.0,
        "baseline_window_hours": 24
      }
    },
    {
      "id": "threshold_monitor",
      "agentType": "conditional",
      "x": 700,
      "y": 300,
      "config": {
        "condition_type": "threshold",
        "thresholds": {
          "error_rate": 0.05,
          "latency_p99_ms": 1000,
          "cpu_percent": 90,
          "memory_percent": 85
        },
        "comparison": "greater_than",
        "sustained_seconds": 60
      }
    },
    {
      "id": "correlation_analyzer",
      "agentType": "fusion",
      "x": 700,
      "y": 400,
      "config": {
        "strategy": "correlation",
        "time_window_seconds": 300,
        "min_correlation": 0.7,
        "cross_service": true,
        "lag_tolerance_seconds": 30
      }
    },
    {
      "id": "alert_classifier",
      "agentType": "hololoom",
      "x": 850,
      "y": 250,
      "config": {
        "pattern": "fast",
        "mode": "alert_classification",
        "severity_levels": ["P1_critical", "P2_high", "P3_medium", "P4_low", "P5_info"],
        "impact_scoring": true,
        "auto_escalation": true
      }
    },
    {
      "id": "deduplication_filter",
      "agentType": "synthesizer",
      "x": 1000,
      "y": 250,
      "config": {
        "extract_type": "deduplication",
        "fingerprint_fields": ["service", "alert_type", "metric"],
        "dedup_window_seconds": 300,
        "max_alerts_per_window": 5,
        "aggregate_duplicates": true
      }
    },
    {
      "id": "runbook_suggester",
      "agentType": "retriever",
      "x": 1150,
      "y": 150,
      "config": {
        "retrieval_type": "semantic",
        "source": "runbook_database",
        "top_k": 3,
        "include_past_resolutions": true,
        "confidence_threshold": 0.6
      }
    },
    {
      "id": "notification_router",
      "agentType": "conditional",
      "x": 1150,
      "y": 350,
      "config": {
        "condition_type": "severity_routing",
        "routes": {
          "P1_critical": ["pager", "slack", "email"],
          "P2_high": ["slack", "email"],
          "P3_medium": ["slack"],
          "P4_low": ["email"],
          "P5_info": ["dashboard"]
        },
        "override_rules": true
      }
    },
    {
      "id": "pager_notifier",
      "agentType": "response",
      "x": 1300,
      "y": 100,
      "config": {
        "format": "pagerduty",
        "include_runbook": true,
        "include_context": true,
        "max_context_lines": 50,
        "escalation_policy": "default"
      }
    },
    {
      "id": "slack_notifier",
      "agentType": "response",
      "x": 1300,
      "y": 250,
      "config": {
        "format": "slack_blocks",
        "channel_routing": true,
        "include_graph": true,
        "include_runbook_link": true,
        "thread_replies": true
      }
    },
    {
      "id": "email_notifier",
      "agentType": "response",
      "x": 1300,
      "y": 400,
      "config": {
        "format": "html_email",
        "include_detailed_report": true,
        "include_historical_context": true,
        "group_by_service": true,
        "digest_interval_minutes": 15
      }
    },
    {
      "id": "metrics_emitter",
      "agentType": "store",
      "x": 1450,
      "y": 250,
      "config": {
        "store_type": "metrics",
        "metrics": ["alerts_generated", "alerts_deduplicated", "notification_latency", "detection_accuracy"],
        "emit_to_prometheus": true,
        "include_labels": true
      }
    },
    {
      "id": "alert_store",
      "agentType": "store",
      "x": 1450,
      "y": 400,
      "config": {
        "store_type": "alert_history",
        "retention_days": 90,
        "index_fields": ["service", "severity", "alert_type"],
        "enable_search": true
      }
    },
    {
      "id": "final_output",
      "agentType": "response",
      "x": 1600,
      "y": 250,
      "config": {
        "format": "stream_summary",
        "include_statistics": true,
        "include_active_alerts": true,
        "real_time_dashboard": true
      }
    }
  ],
  "connections": [
    {"id": "c1", "from": "stream_ingester", "to": "event_parser"},
    {"id": "c2", "from": "event_parser", "to": "window_aggregator"},
    {"id": "c3", "from": "window_aggregator", "to": "parallel_analyzers"},
    {"id": "c4", "from": "parallel_analyzers", "to": "pattern_analyzer"},
    {"id": "c5", "from": "parallel_analyzers", "to": "anomaly_detector"},
    {"id": "c6", "from": "parallel_analyzers", "to": "threshold_monitor"},
    {"id": "c7", "from": "parallel_analyzers", "to": "correlation_analyzer"},
    {"id": "c8", "from": "pattern_analyzer", "to": "alert_classifier"},
    {"id": "c9", "from": "anomaly_detector", "to": "alert_classifier"},
    {"id": "c10", "from": "threshold_monitor", "to": "alert_classifier"},
    {"id": "c11", "from": "correlation_analyzer", "to": "alert_classifier"},
    {"id": "c12", "from": "alert_classifier", "to": "deduplication_filter"},
    {"id": "c13", "from": "deduplication_filter", "to": "runbook_suggester"},
    {"id": "c14", "from": "deduplication_filter", "to": "notification_router"},
    {"id": "c15", "from": "runbook_suggester", "to": "notification_router"},
    {"id": "c16", "from": "notification_router", "to": "pager_notifier", "condition": "severity in ['P1_critical']"},
    {"id": "c17", "from": "notification_router", "to": "slack_notifier", "condition": "severity in ['P1_critical', 'P2_high', 'P3_medium']"},
    {"id": "c18", "from": "notification_router", "to": "email_notifier", "condition": "severity in ['P1_critical', 'P2_high', 'P4_low']"},
    {"id": "c19", "from": "pager_notifier", "to": "metrics_emitter"},
    {"id": "c20", "from": "slack_notifier", "to": "metrics_emitter"},
    {"id": "c21", "from": "email_notifier", "to": "metrics_emitter"},
    {"id": "c22", "from": "metrics_emitter", "to": "alert_store"},
    {"id": "c23", "from": "alert_store", "to": "final_output"}
  ],
  "input_schema": {
    "stream_config": {
      "type": "object",
      "required": true,
      "properties": {
        "source_type": {"type": "string", "enum": ["kafka", "kinesis", "pubsub", "webhook"]},
        "connection_string": {"type": "string"},
        "topic_or_subscription": {"type": "string"},
        "consumer_group": {"type": "string"}
      },
      "description": "Stream source configuration"
    },
    "alert_config": {
      "type": "object",
      "required": false,
      "properties": {
        "severity_thresholds": {"type": "object"},
        "dedup_window_seconds": {"type": "number", "default": 300},
        "notification_channels": {"type": "array"}
      },
      "description": "Alert configuration overrides"
    },
    "runbook_database": {
      "type": "string",
      "required": false,
      "description": "Path or connection to runbook database for auto-suggestions"
    },
    "baseline_config": {
      "type": "object",
      "required": false,
      "properties": {
        "baseline_hours": {"type": "number", "default": 24},
        "min_data_points": {"type": "number", "default": 100}
      },
      "description": "Baseline configuration for anomaly detection"
    }
  },
  "output_schema": {
    "alerts_generated": {
      "type": "number",
      "description": "Total alerts generated in current window"
    },
    "alerts_deduplicated": {
      "type": "number",
      "description": "Number of duplicate alerts suppressed"
    },
    "alerts_by_severity": {
      "type": "object",
      "description": "Alert counts grouped by severity level"
    },
    "notifications_sent": {
      "type": "object",
      "description": "Notification counts by channel (pager, slack, email)"
    },
    "active_alerts": {
      "type": "array",
      "description": "Currently active alerts with details"
    },
    "anomalies_detected": {
      "type": "array",
      "description": "Anomalies detected with confidence scores"
    },
    "correlated_events": {
      "type": "array",
      "description": "Events that were correlated across services"
    },
    "suggested_runbooks": {
      "type": "array",
      "description": "Runbook suggestions for current alerts"
    },
    "processing_stats": {
      "type": "object",
      "properties": {
        "events_processed": {"type": "number"},
        "processing_latency_ms": {"type": "number"},
        "window_start": {"type": "string"},
        "window_end": {"type": "string"}
      }
    }
  },
  "evaluation": {
    "metrics": ["detection_latency", "false_positive_rate", "alert_noise_reduction", "notification_delivery_rate"],
    "success_criteria": {
      "max_detection_latency_ms": 5000,
      "max_false_positive_rate": 0.1,
      "min_noise_reduction": 0.5,
      "min_delivery_rate": 0.99
    }
  }
}
