{
  "version": "1.0",
  "name": "Adaptive Learning Loop",
  "description": "A self-improving workflow that uses Thompson Sampling to select optimal strategies, integrates user feedback to update Bayesian priors, and continuously learns patterns from successful outcomes. Features automatic strategy adaptation, confidence calibration, and comprehensive learning metrics.",
  "tags": ["learning", "thompson-sampling", "feedback", "adaptive", "bayesian", "self-improving", "optimization"],
  "author": "hololoom Team",
  "created": "2025-12-28",
  "nodes": [
    {
      "id": "query_input",
      "agentType": "store",
      "x": 100,
      "y": 250,
      "config": {
        "store_type": "input",
        "track_query_type": true,
        "timestamp": true
      }
    },
    {
      "id": "strategy_selector",
      "agentType": "thompson",
      "x": 250,
      "y": 250,
      "config": {
        "strategies": ["deep_research", "fast_lookup", "graph_exploration", "hybrid"],
        "exploration_rate": 0.1,
        "prior_alpha": 1.0,
        "prior_beta": 1.0,
        "decay_factor": 0.95
      }
    },
    {
      "id": "deep_research_path",
      "agentType": "multiquery",
      "x": 400,
      "y": 100,
      "config": {
        "num_queries": 5,
        "mode": "research",
        "diversity": 0.7,
        "synthesis": true
      }
    },
    {
      "id": "fast_lookup_path",
      "agentType": "retriever",
      "x": 400,
      "y": 200,
      "config": {
        "retrieval_type": "vector",
        "top_k": 10,
        "threshold": 0.7
      }
    },
    {
      "id": "graph_exploration_path",
      "agentType": "fusion",
      "x": 400,
      "y": 300,
      "config": {
        "strategy": "multi_hop",
        "max_hops": 3,
        "follow_relations": true
      }
    },
    {
      "id": "hybrid_path",
      "agentType": "parallel",
      "x": 400,
      "y": 400,
      "config": {
        "strategy": "fan_out",
        "merge": "rrf",
        "weights": {"vector": 0.5, "graph": 0.3, "keyword": 0.2}
      }
    },
    {
      "id": "result_synthesizer",
      "agentType": "synthesizer",
      "x": 550,
      "y": 250,
      "config": {
        "extract_type": "comprehensive",
        "deduplicate": true,
        "rank_by_relevance": true
      }
    },
    {
      "id": "response_generator",
      "agentType": "hololoom",
      "x": 700,
      "y": 250,
      "config": {
        "pattern": "fused",
        "mode": "contextual_generation",
        "use_strategy_context": true
      }
    },
    {
      "id": "confidence_assessor",
      "agentType": "convergence",
      "x": 850,
      "y": 250,
      "config": {
        "strategy": "bayesian_calibration",
        "calibrate_with_history": true,
        "return_uncertainty": true
      }
    },
    {
      "id": "feedback_collector",
      "agentType": "store",
      "x": 1000,
      "y": 250,
      "config": {
        "store_type": "feedback",
        "feedback_types": ["rating", "correction", "accept", "reject", "implicit"],
        "timeout_seconds": 300,
        "async": true
      }
    },
    {
      "id": "outcome_evaluator",
      "agentType": "synthesizer",
      "x": 1150,
      "y": 250,
      "config": {
        "extract_type": "outcome_signal",
        "signals": ["success", "partial", "failure"],
        "weight_explicit": 0.8,
        "weight_implicit": 0.2
      }
    },
    {
      "id": "prior_updater",
      "agentType": "store",
      "x": 1300,
      "y": 150,
      "config": {
        "store_type": "bandit_update",
        "update_rule": "thompson",
        "decay_factor": 0.95,
        "persist": true
      }
    },
    {
      "id": "pattern_learner",
      "agentType": "hololoom",
      "x": 1300,
      "y": 350,
      "config": {
        "pattern": "fast",
        "mode": "pattern_extraction",
        "min_support": 5,
        "max_patterns": 100,
        "prune_stale": true
      }
    },
    {
      "id": "metrics_logger",
      "agentType": "store",
      "x": 1450,
      "y": 250,
      "config": {
        "store_type": "metrics",
        "metrics": ["strategy_distribution", "success_rate", "confidence_calibration", "learning_velocity"],
        "emit_to_prometheus": true
      }
    },
    {
      "id": "final_output",
      "agentType": "response",
      "x": 1600,
      "y": 250,
      "config": {
        "format": "adaptive_response",
        "include_confidence": true,
        "include_strategy": true
      }
    }
  ],
  "connections": [
    {"id": "c1", "from": "query_input", "to": "strategy_selector"},
    {"id": "c2", "from": "strategy_selector", "to": "deep_research_path", "condition": "strategy == 'deep_research'"},
    {"id": "c3", "from": "strategy_selector", "to": "fast_lookup_path", "condition": "strategy == 'fast_lookup'"},
    {"id": "c4", "from": "strategy_selector", "to": "graph_exploration_path", "condition": "strategy == 'graph_exploration'"},
    {"id": "c5", "from": "strategy_selector", "to": "hybrid_path", "condition": "strategy == 'hybrid'"},
    {"id": "c6", "from": "deep_research_path", "to": "result_synthesizer"},
    {"id": "c7", "from": "fast_lookup_path", "to": "result_synthesizer"},
    {"id": "c8", "from": "graph_exploration_path", "to": "result_synthesizer"},
    {"id": "c9", "from": "hybrid_path", "to": "result_synthesizer"},
    {"id": "c10", "from": "result_synthesizer", "to": "response_generator"},
    {"id": "c11", "from": "response_generator", "to": "confidence_assessor"},
    {"id": "c12", "from": "confidence_assessor", "to": "final_output"},
    {"id": "c13", "from": "final_output", "to": "feedback_collector"},
    {"id": "c14", "from": "feedback_collector", "to": "outcome_evaluator"},
    {"id": "c15", "from": "outcome_evaluator", "to": "prior_updater"},
    {"id": "c16", "from": "outcome_evaluator", "to": "pattern_learner"},
    {"id": "c17", "from": "prior_updater", "to": "metrics_logger"},
    {"id": "c18", "from": "pattern_learner", "to": "metrics_logger"}
  ],
  "input_schema": {
    "query": {
      "type": "string",
      "required": true,
      "description": "User query to process"
    },
    "feedback": {
      "type": "object",
      "required": false,
      "properties": {
        "previous_query_id": {"type": "string"},
        "rating": {"type": "number", "min": 1, "max": 5},
        "correction": {"type": "string"},
        "action": {"type": "string", "enum": ["accept", "reject"]}
      },
      "description": "Feedback on a previous response (for learning)"
    },
    "force_strategy": {
      "type": "string",
      "required": false,
      "enum": ["deep_research", "fast_lookup", "graph_exploration", "hybrid"],
      "description": "Override Thompson Sampling and force a specific strategy"
    },
    "exploration_override": {
      "type": "number",
      "required": false,
      "min": 0,
      "max": 1,
      "description": "Temporary override for exploration rate"
    }
  },
  "output_schema": {
    "response": {
      "type": "string",
      "description": "Generated response"
    },
    "confidence": {
      "type": "number",
      "description": "Response confidence (0-1)"
    },
    "uncertainty": {
      "type": "number",
      "description": "Epistemic uncertainty estimate"
    },
    "strategy_used": {
      "type": "string",
      "description": "Strategy selected by Thompson Sampling"
    },
    "strategy_confidence": {
      "type": "number",
      "description": "Confidence in strategy selection"
    },
    "query_id": {
      "type": "string",
      "description": "ID for feedback reference"
    },
    "learning_stats": {
      "type": "object",
      "properties": {
        "strategy_success_rates": {"type": "object"},
        "total_queries": {"type": "number"},
        "exploration_rate": {"type": "number"},
        "patterns_discovered": {"type": "number"},
        "learning_velocity": {"type": "number"}
      }
    }
  },
  "evaluation": {
    "metrics": ["strategy_success_rate", "confidence_calibration", "feedback_incorporation_rate", "learning_velocity", "regret"],
    "success_criteria": {
      "min_success_rate": 0.8,
      "max_calibration_error": 0.1,
      "min_feedback_usage": 0.9,
      "min_learning_velocity": 0.01
    }
  }
}
