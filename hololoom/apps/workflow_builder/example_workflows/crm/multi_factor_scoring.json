{
  "version": "1.0",
  "name": "Multi-Factor Lead Scoring",
  "description": "Score leads using parallel analysis of multiple engagement factors with Thompson Sampling",
  "tags": ["crm", "lead_scoring", "thompson_sampling", "advanced"],
  "author": "hololoom CRM",
  "created": "2025-11-04",
  "nodes": [
    {
      "id": "get_contact",
      "type": "memory_search",
      "label": "Get Contact",
      "position": {"x": 400, "y": 100},
      "config": {
        "query": "type:contact AND email:${input.email}",
        "max_results": 1
      }
    },
    {
      "id": "parallel_analysis",
      "type": "parallel_executor",
      "label": "Parallel Signal Analysis",
      "position": {"x": 400, "y": 220},
      "config": {
        "max_concurrent": 4,
        "timeout_ms": 30000
      }
    },
    {
      "id": "activity_scorer",
      "type": "context_retriever",
      "label": "Activity Frequency",
      "position": {"x": 100, "y": 340},
      "config": {
        "query": "type:activity AND contact:${get_contact.name} AND timestamp:>30days",
        "k": 50
      }
    },
    {
      "id": "value_scorer",
      "type": "context_retriever",
      "label": "Deal Value",
      "position": {"x": 300, "y": 340},
      "config": {
        "query": "type:deal AND contact:${get_contact.name}",
        "k": 20
      }
    },
    {
      "id": "engagement_scorer",
      "type": "context_retriever",
      "label": "Engagement Score",
      "position": {"x": 500, "y": 340},
      "config": {
        "query": "type:activity AND contact:${get_contact.name} AND sentiment:positive",
        "k": 30
      }
    },
    {
      "id": "recency_scorer",
      "type": "synthesizer",
      "label": "Recency Score",
      "position": {"x": 700, "y": 340},
      "config": {
        "extract_temporal": true,
        "time_decay_days": 30
      }
    },
    {
      "id": "fuse_signals",
      "type": "knowledge_fusion",
      "label": "Fuse All Signals",
      "position": {"x": 400, "y": 460},
      "config": {
        "max_depth": 2,
        "min_importance": 0.1,
        "fusion_strategy": "weighted_average"
      }
    },
    {
      "id": "thompson_sampling",
      "type": "thompson_sampler",
      "label": "Adaptive Weighting",
      "position": {"x": 400, "y": 580},
      "config": {
        "exploration_rate": 0.1,
        "alpha_prior": 1.0,
        "beta_prior": 1.0,
        "learn_weights": true
      }
    },
    {
      "id": "final_score",
      "type": "convergence_engine",
      "label": "Final Classification",
      "position": {"x": 400, "y": 700},
      "config": {
        "strategy": "bayesian_blend",
        "neural_weight": 0.5,
        "bandit_weight": 0.5
      }
    },
    {
      "id": "save_score",
      "type": "memory_store",
      "label": "Update Contact Record",
      "position": {"x": 400, "y": 820},
      "config": {
        "backend": "hybrid",
        "update_existing": true,
        "fields_to_update": ["lead_score", "last_scored_at", "score_factors"]
      }
    },
    {
      "id": "generate_report",
      "type": "response_generator",
      "label": "Generate Report",
      "position": {"x": 400, "y": 940},
      "config": {
        "template": "# Lead Score Report\n\n**Contact**: ${get_contact.name}\n**Company**: ${get_contact.company}\n**Final Score**: ${final_score.score}\n**Classification**: ${final_score.classification}\n\n## Factor Breakdown\n- Activity Frequency: ${activity_scorer.score}\n- Deal Value: ${value_scorer.score}\n- Engagement: ${engagement_scorer.score}\n- Recency: ${recency_scorer.score}\n\n## Learned Weights (Thompson Sampling)\n${thompson_sampling.weights}\n\n## Recommendation\n${final_score.recommendation}",
        "format": "markdown"
      }
    }
  ],
  "connections": [
    {
      "id": "conn_1",
      "from": "get_contact",
      "to": "parallel_analysis"
    },
    {
      "id": "conn_2",
      "from": "parallel_analysis",
      "to": "activity_scorer",
      "parallel_branch": 0
    },
    {
      "id": "conn_3",
      "from": "parallel_analysis",
      "to": "value_scorer",
      "parallel_branch": 1
    },
    {
      "id": "conn_4",
      "from": "parallel_analysis",
      "to": "engagement_scorer",
      "parallel_branch": 2
    },
    {
      "id": "conn_5",
      "from": "parallel_analysis",
      "to": "recency_scorer",
      "parallel_branch": 3
    },
    {
      "id": "conn_6",
      "from": "activity_scorer",
      "to": "fuse_signals"
    },
    {
      "id": "conn_7",
      "from": "value_scorer",
      "to": "fuse_signals"
    },
    {
      "id": "conn_8",
      "from": "engagement_scorer",
      "to": "fuse_signals"
    },
    {
      "id": "conn_9",
      "from": "recency_scorer",
      "to": "fuse_signals"
    },
    {
      "id": "conn_10",
      "from": "fuse_signals",
      "to": "thompson_sampling"
    },
    {
      "id": "conn_11",
      "from": "thompson_sampling",
      "to": "final_score"
    },
    {
      "id": "conn_12",
      "from": "final_score",
      "to": "save_score"
    },
    {
      "id": "conn_13",
      "from": "save_score",
      "to": "generate_report"
    }
  ],
  "input_schema": {
    "email": {
      "type": "string",
      "required": true,
      "description": "Contact email address"
    }
  },
  "output_schema": {
    "score": {
      "type": "number",
      "min": 0.0,
      "max": 1.0,
      "description": "Final lead score"
    },
    "classification": {
      "type": "string",
      "enum": ["hot", "warm", "cold", "dead"],
      "description": "Lead classification"
    },
    "factors": {
      "type": "object",
      "description": "Individual factor scores"
    },
    "learned_weights": {
      "type": "object",
      "description": "Thompson Sampling learned factor weights"
    },
    "report": {
      "type": "string",
      "description": "Markdown formatted report"
    }
  }
}
