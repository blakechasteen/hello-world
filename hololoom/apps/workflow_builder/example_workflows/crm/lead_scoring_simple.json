{
  "version": "1.0",
  "name": "Simple Lead Scoring",
  "description": "Score a contact based on engagement and route to appropriate action",
  "tags": ["crm", "lead_scoring", "automation"],
  "author": "hololoom CRM",
  "created": "2025-11-04",
  "nodes": [
    {
      "id": "search_contact",
      "type": "memory_search",
      "label": "Get Contact",
      "position": {"x": 100, "y": 100},
      "config": {
        "query": "type:contact AND email:${input.email}",
        "max_results": 1,
        "similarity_threshold": 0.9
      }
    },
    {
      "id": "get_activities",
      "type": "context_retriever",
      "label": "Get Activities",
      "position": {"x": 100, "y": 220},
      "config": {
        "query": "type:activity AND contact:${search_contact.name}",
        "k": 20,
        "use_fusion": true
      }
    },
    {
      "id": "get_deals",
      "type": "context_retriever",
      "label": "Get Deals",
      "position": {"x": 300, "y": 220},
      "config": {
        "query": "type:deal AND contact:${search_contact.name}",
        "k": 10,
        "use_fusion": true
      }
    },
    {
      "id": "synthesize_signals",
      "type": "synthesizer",
      "label": "Extract Signals",
      "position": {"x": 200, "y": 340},
      "config": {
        "extract_entities": true,
        "extract_motifs": true,
        "extract_sentiment": true
      }
    },
    {
      "id": "calculate_score",
      "type": "convergence_engine",
      "label": "Calculate Score",
      "position": {"x": 200, "y": 460},
      "config": {
        "strategy": "bayesian_blend",
        "neural_weight": 0.7,
        "bandit_weight": 0.3
      }
    },
    {
      "id": "route_by_score",
      "type": "conditional_branch",
      "label": "Route by Score",
      "position": {"x": 200, "y": 580},
      "config": {
        "condition": "${calculate_score.score} >= 0.75"
      }
    },
    {
      "id": "hot_lead_action",
      "type": "response_generator",
      "label": "Hot Lead Action",
      "position": {"x": 50, "y": 700},
      "config": {
        "template": "Hot lead detected! Send proposal to ${search_contact.name} at ${search_contact.company}. Score: ${calculate_score.score}",
        "format": "markdown"
      }
    },
    {
      "id": "warm_lead_action",
      "type": "response_generator",
      "label": "Warm Lead Action",
      "position": {"x": 250, "y": 700},
      "config": {
        "template": "Warm lead: Schedule follow-up call with ${search_contact.name}. Score: ${calculate_score.score}",
        "format": "markdown"
      }
    },
    {
      "id": "cold_lead_action",
      "type": "response_generator",
      "label": "Cold Lead Action",
      "position": {"x": 450, "y": 700},
      "config": {
        "template": "Cold lead: Add ${search_contact.name} to nurture email sequence. Score: ${calculate_score.score}",
        "format": "markdown"
      }
    }
  ],
  "connections": [
    {
      "id": "conn_1",
      "from": "search_contact",
      "to": "get_activities",
      "from_port": "output",
      "to_port": "input"
    },
    {
      "id": "conn_2",
      "from": "search_contact",
      "to": "get_deals",
      "from_port": "output",
      "to_port": "input"
    },
    {
      "id": "conn_3",
      "from": "get_activities",
      "to": "synthesize_signals",
      "from_port": "output",
      "to_port": "input"
    },
    {
      "id": "conn_4",
      "from": "get_deals",
      "to": "synthesize_signals",
      "from_port": "output",
      "to_port": "input"
    },
    {
      "id": "conn_5",
      "from": "synthesize_signals",
      "to": "calculate_score",
      "from_port": "output",
      "to_port": "input"
    },
    {
      "id": "conn_6",
      "from": "calculate_score",
      "to": "route_by_score",
      "from_port": "output",
      "to_port": "input"
    },
    {
      "id": "conn_7",
      "from": "route_by_score",
      "to": "hot_lead_action",
      "from_port": "true",
      "to_port": "input",
      "condition": "${score} >= 0.75"
    },
    {
      "id": "conn_8",
      "from": "route_by_score",
      "to": "warm_lead_action",
      "from_port": "false",
      "to_port": "input",
      "condition": "${score} >= 0.50 && ${score} < 0.75"
    },
    {
      "id": "conn_9",
      "from": "route_by_score",
      "to": "cold_lead_action",
      "from_port": "false",
      "to_port": "input",
      "condition": "${score} < 0.50"
    }
  ],
  "input_schema": {
    "email": {
      "type": "string",
      "required": true,
      "description": "Email address of contact to score"
    }
  },
  "output_schema": {
    "score": {
      "type": "number",
      "description": "Lead score (0.0-1.0)"
    },
    "classification": {
      "type": "string",
      "enum": ["hot", "warm", "cold"],
      "description": "Lead classification"
    },
    "action": {
      "type": "string",
      "description": "Recommended next action"
    }
  }
}
