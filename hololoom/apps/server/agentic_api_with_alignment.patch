class ServerState:
    """Global server state."""
    def __init__(self):
        self.config = Config.fast()
        self.orchestrator: Optional[Any] = None
        self.audit_trail: Optional[AuditTrail] = None
        self.safety_guardrails: Optional[SafetyGuardrails] = None  # NEW
        self.deception_detector: Optional[DeceptionDetector] = None  # NEW
        self.shards: List[MemoryShard] = []

        # Initialize alignment components
        try:
            self.safety_guardrails = SafetyGuardrails(
                enable_human_in_loop=False,  # For demo, auto-approve LOW/MEDIUM
                config=self.config
            )
            self.deception_detector = DeceptionDetector()
            logger.info("✅ Alignment framework initialized (SafetyGuardrails + DeceptionDetection)")
        except Exception as e:
            logger.warning(f"⚠️  Alignment framework initialization failed: {e}")
            logger.warning("   Proceeding without safety gating (NOT RECOMMENDED for production)")


# ============================================================================
# CHANGE 3: Add Safety Gating in /query Endpoint (lines 573-591)
# ============================================================================

# BEFORE:
        # Create query
        query = Query(text=text_value)

        # Add code context to metadata
        if request.context:
            query.metadata = { ... }

        # Run agentic reasoning
        logger.info(f"Query: {request.text[:100]}... (mode={request.mode})")
