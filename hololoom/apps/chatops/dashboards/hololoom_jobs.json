{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "HoloLoom ChatOps Job Observability - Real-time monitoring of async weave jobs",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "title": "Job Throughput",
      "description": "Rate of completed jobs over time",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "jobs/min",
            "fillOpacity": 10,
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "auto"
          },
          "unit": "short"
        }
      },
      "targets": [
        {
          "expr": "rate(hololoom_jobs_total{status=\"completed\"}[5m]) * 60",
          "legendFormat": "Completed/min",
          "refId": "A"
        },
        {
          "expr": "rate(hololoom_jobs_total{status=\"failed\"}[5m]) * 60",
          "legendFormat": "Failed/min",
          "refId": "B"
        }
      ]
    },
    {
      "title": "Queue Depth",
      "description": "Current number of pending + running jobs",
      "type": "gauge",
      "gridPos": {"h": 8, "w": 6, "x": 12, "y": 0},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 5},
              {"color": "orange", "value": 10},
              {"color": "red", "value": 20}
            ]
          },
          "unit": "short",
          "min": 0,
          "max": 30
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "expr": "hololoom_jobs_pending + hololoom_jobs_running",
          "legendFormat": "Queue Depth",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Jobs by Status",
      "description": "Current job counts by status",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "unit": "short"
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "reduceOptions": {"calcs": ["lastNotNull"]}
      },
      "targets": [
        {"expr": "hololoom_jobs_pending", "legendFormat": "Pending", "refId": "A"},
        {"expr": "hololoom_jobs_running", "legendFormat": "Running", "refId": "B"}
      ]
    },
    {
      "title": "Total Jobs",
      "description": "Cumulative job counts",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 4},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "steps": [
              {"color": "blue", "value": null}
            ]
          },
          "unit": "short"
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {"calcs": ["lastNotNull"]}
      },
      "targets": [
        {"expr": "sum(hololoom_jobs_total)", "legendFormat": "Total", "refId": "A"}
      ]
    },
    {
      "title": "Latency Percentiles",
      "description": "Job duration percentiles over time",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {
            "axisCenteredZero": false,
            "axisLabel": "ms",
            "fillOpacity": 5,
            "lineWidth": 2
          },
          "unit": "ms"
        }
      },
      "targets": [
        {"expr": "hololoom_job_duration_ms{quantile=\"0.50\"}", "legendFormat": "p50", "refId": "A"},
        {"expr": "hololoom_job_duration_ms{quantile=\"0.90\"}", "legendFormat": "p90", "refId": "B"},
        {"expr": "hololoom_job_duration_ms{quantile=\"0.95\"}", "legendFormat": "p95", "refId": "C"},
        {"expr": "hololoom_job_duration_ms{quantile=\"0.99\"}", "legendFormat": "p99", "refId": "D"}
      ]
    },
    {
      "title": "Error Rate",
      "description": "Job errors per minute by type",
      "type": "timeseries",
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 8},
      "fieldConfig": {
        "defaults": {
          "color": {"fixedColor": "red", "mode": "fixed"},
          "custom": {"fillOpacity": 20, "lineWidth": 2},
          "unit": "short"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(hololoom_job_errors_total[5m])) by (error_type) * 60",
          "legendFormat": "{{error_type}}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Jobs Per Minute",
      "description": "Rolling jobs per minute rate",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 12},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 50},
              {"color": "red", "value": 100}
            ]
          },
          "unit": "short"
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {"calcs": ["lastNotNull"]}
      },
      "targets": [
        {"expr": "hololoom_jobs_per_minute", "legendFormat": "JPM", "refId": "A"}
      ]
    },
    {
      "title": "Tool Usage",
      "description": "Distribution of tool usage across jobs",
      "type": "piechart",
      "gridPos": {"h": 8, "w": 6, "x": 18, "y": 8},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "unit": "short"
        }
      },
      "options": {
        "legend": {"displayMode": "table", "placement": "right"},
        "pieType": "pie",
        "reduceOptions": {"calcs": ["lastNotNull"]}
      },
      "targets": [
        {
          "expr": "hololoom_tool_usage_total",
          "legendFormat": "{{tool}}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Confidence Distribution",
      "description": "Histogram of job confidence scores",
      "type": "histogram",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "unit": "short"
        }
      },
      "options": {
        "bucketOffset": 0,
        "legend": {"displayMode": "list", "placement": "bottom"}
      },
      "targets": [
        {
          "expr": "hololoom_job_confidence_bucket",
          "legendFormat": "le={{le}}",
          "refId": "A",
          "format": "heatmap"
        }
      ]
    },
    {
      "title": "Mean Latency",
      "description": "Average job duration",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 16},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 500},
              {"color": "red", "value": 1000}
            ]
          },
          "unit": "ms"
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {"calcs": ["mean"]}
      },
      "targets": [
        {
          "expr": "rate(hololoom_job_duration_ms_sum[5m]) / rate(hololoom_job_duration_ms_count[5m])",
          "legendFormat": "Mean",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Mean Confidence",
      "description": "Average job confidence score",
      "type": "gauge",
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 20},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "steps": [
              {"color": "red", "value": null},
              {"color": "yellow", "value": 0.6},
              {"color": "green", "value": 0.8}
            ]
          },
          "unit": "percentunit",
          "min": 0,
          "max": 1
        }
      },
      "options": {
        "reduceOptions": {"calcs": ["mean"]},
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "expr": "avg(hololoom_job_confidence_bucket{le=\"1.0\"})",
          "legendFormat": "Confidence",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Success Rate",
      "description": "Percentage of successful jobs",
      "type": "gauge",
      "gridPos": {"h": 8, "w": 6, "x": 18, "y": 16},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "steps": [
              {"color": "red", "value": null},
              {"color": "yellow", "value": 0.9},
              {"color": "green", "value": 0.95}
            ]
          },
          "unit": "percentunit",
          "min": 0,
          "max": 1
        }
      },
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "showThresholdLabels": true,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "expr": "hololoom_jobs_total{status=\"completed\"} / (hololoom_jobs_total{status=\"completed\"} + hololoom_jobs_total{status=\"failed\"})",
          "legendFormat": "Success Rate",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["hololoom", "chatops", "jobs", "observability"],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": ["5s", "10s", "30s", "1m", "5m"]
  },
  "timezone": "browser",
  "title": "HoloLoom Job Observability",
  "uid": "hololoom-jobs-v1",
  "version": 1,
  "weekStart": ""
}
