{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "hololoom SaaS Toolkit - Health & Feature Monitoring",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "title": "Service Health",
      "description": "Current service health status (1 = healthy, 0 = unhealthy)",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "green", "value": 1}
            ]
          },
          "mappings": [
            {"type": "value", "options": {"0": {"text": "UNHEALTHY", "color": "red"}}},
            {"type": "value", "options": {"1": {"text": "HEALTHY", "color": "green"}}}
          ]
        }
      },
      "targets": [
        {
          "expr": "hololoom_saas_up",
          "legendFormat": "Health",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Uptime",
      "description": "Service uptime in hours",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "unit": "h",
          "decimals": 1
        }
      },
      "targets": [
        {
          "expr": "hololoom_saas_uptime_seconds / 3600",
          "legendFormat": "Uptime",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Backend Type",
      "description": "Current database backend (postgresql or sqlite)",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "fixed", "fixedColor": "blue"}
        }
      },
      "options": {
        "textMode": "name"
      },
      "targets": [
        {
          "expr": "hololoom_saas_info",
          "legendFormat": "{{backend}}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Error Rate",
      "description": "Error rate as percentage of total requests",
      "type": "gauge",
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 1},
              {"color": "orange", "value": 5},
              {"color": "red", "value": 10}
            ]
          },
          "unit": "percent",
          "min": 0,
          "max": 100
        }
      },
      "targets": [
        {
          "expr": "(hololoom_saas_errors_total / hololoom_saas_requests_total) * 100",
          "legendFormat": "Error %",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Request Rate",
      "description": "Requests per minute over time",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "req/min",
            "fillOpacity": 10,
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "auto"
          },
          "unit": "short"
        }
      },
      "targets": [
        {
          "expr": "rate(hololoom_saas_requests_total[5m]) * 60",
          "legendFormat": "Requests/min",
          "refId": "A"
        },
        {
          "expr": "rate(hololoom_saas_errors_total[5m]) * 60",
          "legendFormat": "Errors/min",
          "refId": "B"
        }
      ]
    },
    {
      "title": "Total Requests",
      "description": "Cumulative request count",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 4},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "unit": "short"
        }
      },
      "targets": [
        {
          "expr": "hololoom_saas_requests_total",
          "legendFormat": "Total",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Total Errors",
      "description": "Cumulative error count",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 4},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 10},
              {"color": "red", "value": 50}
            ]
          },
          "unit": "short"
        }
      },
      "targets": [
        {
          "expr": "hololoom_saas_errors_total",
          "legendFormat": "Errors",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Feature Flags",
      "description": "Enabled features (1 = enabled, 0 = disabled)",
      "type": "table",
      "gridPos": {"h": 6, "w": 12, "x": 12, "y": 8},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "green", "value": 1}
            ]
          },
          "mappings": [
            {"type": "value", "options": {"0": {"text": "DISABLED", "color": "red"}}},
            {"type": "value", "options": {"1": {"text": "ENABLED", "color": "green"}}}
          ]
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "Feature"},
            "properties": [{"id": "custom.width", "value": 150}]
          }
        ]
      },
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "expr": "hololoom_saas_feature_enabled",
          "legendFormat": "{{feature}}",
          "refId": "A",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "renameByName": {"feature": "Feature", "Value": "Status"}
          }
        }
      ]
    },
    {
      "title": "Uptime History",
      "description": "Service health over time",
      "type": "timeseries",
      "gridPos": {"h": 6, "w": 12, "x": 0, "y": 12},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "green", "value": 1}
            ]
          },
          "custom": {
            "fillOpacity": 50,
            "lineWidth": 1,
            "spanNulls": true
          },
          "min": 0,
          "max": 1
        }
      },
      "targets": [
        {
          "expr": "hololoom_saas_up",
          "legendFormat": "Health",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["hololoom", "saas", "health"],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "title": "hololoom SaaS Health",
  "uid": "hololoom-saas-health",
  "version": 1,
  "weekStart": ""
}
