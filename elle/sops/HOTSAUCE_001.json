  "steps": [
    {
      "step_number": 1,
      "description": "Wearing gloves, remove stems from peppers, chop roughly",
      "duration_minutes": 30,
      "step_type": "PREP",
      "equipment_needed": ["Nitrile gloves", "Knife", "Cutting board"],
      "safety_notes": ["CRITICAL: Wear gloves and eye protection - habanero oil burns severely"]
    },
    {
      "step_number": 2,
      "description": "Peel and chop garlic and onions",
      "duration_minutes": 10,
      "step_type": "PREP",
      "equipment_needed": ["Knife"],
      "safety_notes": []
    },
    {
      "step_number": 3,
      "description": "Combine peppers, garlic, onion in food-grade container",
      "duration_minutes": 5,
      "step_type": "PREP",
      "equipment_needed": ["Food-grade fermentation vessel"],
      "safety_notes": []
    },
    {
      "step_number": 4,
      "description": "Dissolve 4 oz sea salt in 1 quart filtered water, pour over peppers",
      "duration_minutes": 5,
      "step_type": "PROCESS",
      "equipment_needed": ["Measuring cup", "Water"],
      "safety_notes": ["All peppers must be submerged in brine"]
    },
    {
      "step_number": 5,
      "description": "Weight down peppers to keep submerged, cover loosely",
      "duration_minutes": 5,
      "step_type": "PREP",
      "equipment_needed": ["Weight or fermentation weight", "Cloth cover"],
      "safety_notes": []
    },
    {
      "step_number": 6,
      "description": "Ferment at room temperature (65-75°F) for 7 days",
      "duration_minutes": 10080,
      "step_type": "WAIT",
      "equipment_needed": ["Cool, dark storage area"],
      "safety_notes": ["Check daily for mold - skim surface if needed"]
    },
    {
      "step_number": 7,
      "description": "Drain fermented peppers, RESERVE BRINE",
      "duration_minutes": 10,
      "step_type": "PROCESS",
      "equipment_needed": ["Colander", "Bowl for catching brine"],
      "safety_notes": ["Still wear gloves"]
    },
    {
      "step_number": 8,
      "description": "Blend peppers with vinegar, cumin, paprika until smooth",
      "duration_minutes": 10,
      "step_type": "PROCESS",
      "equipment_needed": ["High-speed blender"],
      "safety_notes": ["Blend in well-ventilated area - fumes can burn eyes"]
    },
    {
      "step_number": 9,
      "description": "Add reserved brine to reach desired consistency, blend again",
      "duration_minutes": 5,
      "step_type": "PROCESS",
      "equipment_needed": ["Blender"],
      "safety_notes": []
    },
    {
      "step_number": 10,
      "description": "Strain through fine mesh to remove seeds and large particles",
      "duration_minutes": 15,
      "step_type": "PROCESS",
      "equipment_needed": ["Fine mesh strainer or cheesecloth"],
      "safety_notes": ["Optional - some prefer seeds for texture"]
    },
    {
      "step_number": 11,
      "description": "Blend in xanthan gum to thicken and prevent separation",
      "duration_minutes": 5,
      "step_type": "PROCESS",
      "equipment_needed": ["Blender"],
      "safety_notes": ["Add gradually while blending to prevent clumping"]
    },
    {
      "step_number": 12,
      "description": "Simmer sauce at 180°F for 10 minutes to pasteurize (optional)",
      "duration_minutes": 15,
      "step_type": "PROCESS",
      "equipment_needed": ["Pot", "Thermometer"],
      "safety_notes": ["Do not boil - destroys probiotics but extends shelf life"]
    },
    {
      "step_number": 13,
      "description": "Fill 5oz bottles while sauce is warm, leave 1/4 inch headspace",
      "duration_minutes": 30,
      "step_type": "PACKAGE",
