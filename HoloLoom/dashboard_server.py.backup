            border-bottom: 1px solid #2a3555;
        }
        th {
            color: #00d4ff;
            font-weight: 600;
        }
        .timestamp {
            color: #666;
            font-size: 12px;
        }

        /* Loading Skeleton Styles */
        .skeleton {
            background: linear-gradient(90deg, #1a1f3a 25%, #2a3555 50%, #1a1f3a 75%);
            background-size: 200% 100%;
            animation: shimmer 1.5s infinite;
