{
  "version": "1.0",
  "name": "Adversarial Verification Pipeline",
  "description": "Generates an answer, then an adversarial critique, then resolves disagreements through consensus. Inspired by debate-based AI safety.",
  "tags": ["verification", "adversarial", "debate", "safety", "consensus"],
  "author": "HoloLoom Team",
  "created": "2025-12-23",

  "nodes": [
    {
      "id": "initial_answer",
      "agentType": "hololoom",
      "x": 100,
      "y": 150,
      "config": {
        "pattern": "fused",
        "role": "answerer",
        "description": "Generate initial comprehensive answer"
      }
    },
    {
      "id": "adversarial_critique",
      "agentType": "hololoom",
      "x": 100,
      "y": 300,
      "config": {
        "pattern": "fused",
        "role": "critic",
        "system_prompt": "You are a critical reviewer. Find flaws, missing information, and potential errors in the given answer. Be thorough but fair.",
        "description": "Generate adversarial critique of the answer"
      }
    },
    {
      "id": "safety_screen",
      "agentType": "safety",
      "x": 250,
      "y": 150,
      "config": {
        "risk_threshold": 0.3,
        "description": "Screen initial answer for safety issues"
      }
    },
    {
      "id": "extract_claims",
      "agentType": "synthesizer",
      "x": 400,
      "y": 150,
      "config": {
        "extract_type": "claims",
        "description": "Extract verifiable claims from answer"
      }
    },
    {
      "id": "extract_critiques",
      "agentType": "synthesizer",
      "x": 400,
      "y": 300,
      "config": {
        "extract_type": "critiques",
        "description": "Extract specific critiques and objections"
      }
    },
    {
      "id": "verify_claims",
      "agentType": "search",
      "x": 550,
      "y": 150,
      "config": {
        "k": 5,
        "strategy": "connected",
        "description": "Search for evidence supporting/refuting claims"
      }
    },
    {
      "id": "disagreement_detector",
      "agentType": "convergence",
      "x": 550,
      "y": 225,
      "config": {
        "strategy": "bayesian_blend",
        "description": "Detect and quantify disagreements between answer and critique"
      }
    },
    {
      "id": "has_major_disagreement",
      "agentType": "conditional",
      "x": 700,
      "y": 225,
      "config": {
        "condition": "disagreement_score > 0.4",
        "threshold": 0.4
      }
    },
    {
      "id": "resolution_search",
      "agentType": "fusion",
      "x": 850,
      "y": 300,
      "config": {
        "max_hops": 4,
        "description": "Deep graph search to resolve major disagreements"
      }
    },
    {
      "id": "arbiter_decision",
      "agentType": "hololoom",
      "x": 1000,
      "y": 300,
      "config": {
        "pattern": "fused",
        "role": "arbiter",
        "system_prompt": "You are a neutral arbiter. Given the original answer, the critique, and the evidence, determine the correct position. Be objective and cite evidence.",
        "description": "Make final decision on disputed points"
      }
    },
    {
      "id": "merge_results",
      "agentType": "refiner",
      "x": 850,
      "y": 150,
      "config": {
        "strategy": "elegance",
        "max_iterations": 2,
        "description": "Merge verified claims into coherent response"
      }
    },
    {
      "id": "final_synthesis",
      "agentType": "response",
      "x": 1000,
      "y": 150,
      "config": {
        "format": "structured",
        "include_confidence": true,
        "include_sources": true
      }
    },
    {
      "id": "audit_log",
      "agentType": "store",
      "x": 1150,
      "y": 225,
      "config": {
        "description": "Log verification chain for audit trail"
      }
    }
  ],

  "connections": [
    {"id": "c1", "from": "initial_answer", "to": "safety_screen"},
    {"id": "c2", "from": "initial_answer", "to": "adversarial_critique"},
    {"id": "c3", "from": "safety_screen", "to": "extract_claims"},
    {"id": "c4", "from": "adversarial_critique", "to": "extract_critiques"},
    {"id": "c5", "from": "extract_claims", "to": "verify_claims"},
    {"id": "c6", "from": "extract_claims", "to": "disagreement_detector"},
    {"id": "c7", "from": "extract_critiques", "to": "disagreement_detector"},
    {"id": "c8", "from": "disagreement_detector", "to": "has_major_disagreement"},
    {"id": "c9", "from": "has_major_disagreement", "to": "merge_results", "condition": "false"},
    {"id": "c10", "from": "has_major_disagreement", "to": "resolution_search", "condition": "true"},
    {"id": "c11", "from": "resolution_search", "to": "arbiter_decision"},
    {"id": "c12", "from": "arbiter_decision", "to": "merge_results"},
    {"id": "c13", "from": "verify_claims", "to": "merge_results"},
    {"id": "c14", "from": "merge_results", "to": "final_synthesis"},
    {"id": "c15", "from": "final_synthesis", "to": "audit_log"}
  ],

  "input_schema": {
    "query": {
      "type": "string",
      "required": true,
      "description": "Question requiring verified, adversarially-tested answer"
    }
  },

  "output_schema": {
    "response": {
      "type": "string",
      "description": "Verified response after adversarial testing"
    },
    "confidence": {
      "type": "number",
      "description": "Confidence after verification"
    },
    "claims_verified": {
      "type": "number",
      "description": "Number of claims that passed verification"
    },
    "disagreements_resolved": {
      "type": "number",
      "description": "Number of disagreements resolved by arbiter"
    },
    "safety_passed": {
      "type": "boolean",
      "description": "Whether safety screening passed"
    }
  },

  "evaluation": {
    "metrics": ["accuracy", "disagreement_rate", "resolution_rate", "latency_ms"],
    "success_criteria": {
      "min_claims_verified": 0.8,
      "max_unresolved_disagreements": 0.1
    }
  }
}
