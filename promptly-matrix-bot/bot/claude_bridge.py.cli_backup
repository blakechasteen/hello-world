#!/usr/bin/env python3
"""
Claude Code CLI Bridge for Promptly Matrix Bot

Simple subprocess integration with Claude Code CLI.
Provides code review, explanation, and refactoring via Matrix chat.
"""

import subprocess
import logging
import os
from typing import Optional

logger = logging.getLogger(__name__)


class ClaudeBridge:
    """Bridge to Claude Code via CLI"""

    def __init__(self, claude_path: str = "claude", repo_path: Optional[str] = None):
        """
        Initialize Claude Code bridge.

        Args:
            claude_path: Path to claude executable (default: 'claude' from PATH)
            repo_path: Repository path for context
        """
        self.claude_path = claude_path
        self.repo_path = repo_path or "."

    def _run_command(self, args: list, timeout: int = 120) -> str:
        """
        Run claude CLI command safely.

        Args:
            args: Command arguments
            timeout: Timeout in seconds

        Returns:
            Command output as string
        """
        try:
            result = subprocess.run(
                [self.claude_path] + args,
                capture_output=True,
                text=True,
                cwd=self.repo_path,
                timeout=timeout
            )

            if result.returncode == 0:
                return result.stdout.strip()
            else:
                error = result.stderr.strip() or result.stdout.strip()
                return f"Error: {error}"

        except subprocess.TimeoutExpired:
            return f"Error: Command timed out (>{timeout}s)"
        except FileNotFoundError:
            return "Error: Claude Code CLI not found. Is it installed and in PATH?"
        except Exception as e:
            logger.error(f"Claude command error: {e}")
            return f"Error: {e}"

    def review(self, file_path: str) -> str:
        """
        Request code review from Claude Code.

        Args:
            file_path: Path to file to review (relative to repo)

        Returns:
            Review results as string
        """
        logger.info(f"Requesting review for: {file_path}")

        # Try different possible command formats
        # Claude Code CLI might use: claude review, claude code review, etc.
        possible_commands = [
            ['review', file_path],
            ['code', 'review', file_path],
            ['code-review', file_path],
        ]

        for cmd in possible_commands:
            result = self._run_command(cmd, timeout=180)
            if not result.startswith("Error:"):
                return result

        # If all failed, return the last error
        return result

    def explain(self, file_path: str, question: Optional[str] = None) -> str:
        """
        Ask Claude Code to explain code.

        Args:
            file_path: Path to file
            question: Optional specific question

        Returns:
            Explanation as string
        """
        logger.info(f"Requesting explanation for: {file_path}")

        if question:
            # Try with question
            result = self._run_command(
                ['explain', file_path, '--question', question],
                timeout=120
            )
            if not result.startswith("Error:"):
                return result

        # Fallback to simple explain
        return self._run_command(['explain', file_path], timeout=120)

    def chat(self, message: str, context_file: Optional[str] = None) -> str:
        """
        Chat with Claude Code (general questions).

        Args:
            message: Question or message
            context_file: Optional file for context

        Returns:
            Claude's response
        """
        logger.info("Claude Code chat request")

        args = ['chat', message]
        if context_file:
            args.extend(['--file', context_file])

        return self._run_command(args, timeout=60)

    def refactor(self, file_path: str, instruction: str) -> str:
        """
        Request refactoring from Claude Code.

        Args:
            file_path: Path to file to refactor
            instruction: What to refactor

        Returns:
            Refactoring results
        """
        logger.info(f"Requesting refactor for: {file_path}")

        return self._run_command(
            ['refactor', file_path, '--instruction', instruction],
            timeout=300  # 5 minutes for refactoring
        )

    def is_available(self) -> bool:
        """
        Check if Claude Code CLI is available.

        Returns:
            True if claude CLI is found
        """
        try:
            result = subprocess.run(
                [self.claude_path, '--version'],
                capture_output=True,
                text=True,
                timeout=5
            )
            return result.returncode == 0
        except (FileNotFoundError, subprocess.TimeoutExpired):
            return False


# Example usage
if __name__ == "__main__":
    import sys

    # Test Claude Code bridge
    bridge = ClaudeBridge()

    print("=== Testing Claude Code CLI ===")

    # Check if available
    if bridge.is_available():
        print("✅ Claude Code CLI is available")
    else:
        print("❌ Claude Code CLI not found")
        print("   Install from: https://claude.ai/download")
        sys.exit(1)

    # Test chat
    print("\n=== Testing Chat ===")
    response = bridge.chat("What is Python?")
    print(response[:200] if len(response) > 200 else response)

    print("\n✅ Claude Code bridge working!")
